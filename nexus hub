local function getClosestTarget(fov)
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local mousePos = UIS:GetMouseLocation()
    local best, bestDist = nil, fov
    local myChar = LocalPlayer.Character
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local char = p.Character
            local bone = char:FindFirstChild(Config.SilentAim.Bone)
            local hum = char:FindFirstChildOfClass("Humanoid")
            if bone and hum and hum.Health > 0 then
                local screenPos, onScreen = cam:WorldToViewportPoint(bone.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    if dist < bestDist then
                        local blocked = false
                        if Config.SilentAim.WallCheck then
                            rayParams.FilterDescendantsInstances = {myChar, char}
                            local origin = cam.CFrame.Position
                            local ray = workspace:Raycast(origin, bone.Position - origin, rayParams)
                            if ray then blocked = true end
                        end
                        if not blocked then best, bestDist = p, dist end
                    end
                end
            end
        end
    end
    return best
end

pcall(function()
    local mt = getrawmetatable(game)
    local oldNamecall = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if Config.SilentAim.Enabled and method == "FireServer"
            and typeof(self) == "Instance" and self.Name:lower():find("shoot")
            and UIS:IsKeyDown(Config.SilentAim.Key) then
            local target = Config.Target
            if target and target.Character then
                local bone = target.Character:FindFirstChild(Config.SilentAim.Bone)
                local hrp = target.Character:FindFirstChild("HumanoidRootPart")
                if bone then
                    local args = {...}
                    local predicted = bone.Position
                    if hrp then predicted = predicted + hrp.AssemblyLinearVelocity * Config.SilentAim.Prediction end
                    args[1] = predicted
                    return oldNamecall(self, unpack(args))
                end
            end
        end
        return oldNamecall(self, ...)
    end)
    setreadonly(mt, true)
end)

