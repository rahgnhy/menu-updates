do
    local dragging, didDrag, startPos, initPos
    MinIcon.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging, didDrag = true, false; startPos = inp.Position; initPos = MinIcon.Position
        end
    end)
    UIS.InputChanged:Connect(function(inp)
        if dragging and inp.UserInputType == Enum.UserInputType.MouseMovement then
            local d = inp.Position - startPos
            if math.abs(d.X) > 4 or math.abs(d.Y) > 4 then
                didDrag = true
                MinIcon.Position = UDim2.new(initPos.X.Scale, initPos.X.Offset+d.X, initPos.Y.Scale, initPos.Y.Offset+d.Y)
            end
        end
    end)
    UIS.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 and dragging then
            dragging = false
            if not didDrag then
                MinIcon.Visible = false
                Main.Visible = true
                Main.Size = UDim2.new(0,740,0,480)
                Main.Position = UDim2.new(0.5,-370,0.5,-240)
                Main.BackgroundTransparency = 1; MainStroke.Transparency = 1
                TweenService:Create(Main, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {BackgroundTransparency=0}):Play()
                TweenService:Create(MainStroke, TweenInfo.new(0.25), {Transparency=0.15}):Play()
            end
        end
    end)
end

