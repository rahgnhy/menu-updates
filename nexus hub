                    reticlePulse.Radius = 20 + (math.sin(t * 3) * 0.5 + 0.5) * 8
                    reticlePulse.Transparency = 0.7 - (math.sin(t * 3) * 0.5 + 0.5) * 0.4
                    reticlePulse.Visible = true
                end
                reticleDot.Position = Vector2.new(sp.X, sp.Y)
                reticleDot.Radius = 2.5 + pulse * 1
                reticleDot.Visible = true
                if showDistLabel then
                    local hrp = Config.Target.Character:FindFirstChild("HumanoidRootPart")
