local ESPData = {}

local function hardShutdown()
    Killed = true
    Config.SilentAim.Enabled = false
    Config.Aimlock.Enabled = false
    Config.ESP.Enabled = false
    Config.Movement.Enabled = false
    Config.Target = nil
    for _, d in pairs(ESPData) do
        if d.root then d.root.Visible = false end
        if d.skeleton then
            for _, l in ipairs(d.skeleton) do
                pcall(function() l.Visible = false end)
                pcall(function() l:Remove() end)
            end
        end
        if d.head then
            pcall(function() d.head.Visible = false end)
            pcall(function() d.head:Remove() end)
        end
    end
    pcall(function() FOVOuter.Visible = false end)
    pcall(function() FOVOuter:Remove() end)
    pcall(function() FOVInner.Visible = false end)
    pcall(function() FOVInner:Remove() end)
    pcall(function() FOVDot.Visible = false end)
    pcall(function() FOVDot:Remove() end)
    pcall(function() FOVTracer.Visible = false end)
    pcall(function() FOVTracer:Remove() end)
    if reticleBrackets then
        for _, b in ipairs(reticleBrackets) do
            pcall(function() b.Visible = false end)
            pcall(function() b:Remove() end)
        end
    end
    pcall(function() reticleRing.Visible = false end)
    pcall(function() reticleRing:Remove() end)
    pcall(function() reticlePulse.Visible = false end)
    pcall(function() reticlePulse:Remove() end)
    pcall(function() reticleDot.Visible = false end)
    pcall(function() reticleDot:Remove() end)
    pcall(function() reticleDist.Visible = false end)
    pcall(function() reticleDist:Remove() end)
    if ScreenGui then ScreenGui.Enabled = false end
    if HUDScreenGui then HUDScreenGui.Enabled = false end
    if ESPLayer then ESPLayer.Enabled = false end
    task.wait(0.05)
    pcall(function() if ScreenGui then ScreenGui:Destroy() end end)
    pcall(function() if HUDScreenGui then HUDScreenGui:Destroy() end end)
    pcall(function() if ESPLayer then ESPLayer:Destroy() end end)
end

