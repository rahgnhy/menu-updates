local CFG_FOLDER = "NexusConfigs"
local function ensureFolder()
    if isfolder and not isfolder(CFG_FOLDER) then pcall(function() makefolder(CFG_FOLDER) end) end
end
local function cfgPath(name) return CFG_FOLDER .. "/" .. name .. ".json" end

local function saveConfig(name)
    ensureFolder()
    local data = {
        SilentAim = { Enabled=Config.SilentAim.Enabled, Key=Config.SilentAim.Key.Name, FOV=Config.SilentAim.FOV, FOVVisible=Config.SilentAim.FOVVisible, Bone=Config.SilentAim.Bone, WallCheck=Config.SilentAim.WallCheck, Prediction=Config.SilentAim.Prediction, Method=Config.SilentAim.Method, ShowRing=Config.SilentAim.ShowRing, ShowLine=Config.SilentAim.ShowLine, ShowDist=Config.SilentAim.ShowDist },
        Aimlock = { Enabled=Config.Aimlock.Enabled, Key=Config.Aimlock.Key.Name, FOV=Config.Aimlock.FOV, Bone=Config.Aimlock.Bone, WallCheck=Config.Aimlock.WallCheck, TeamCheck=Config.Aimlock.TeamCheck, ShowFOV=Config.Aimlock.ShowFOV, ShowRing=Config.Aimlock.ShowRing, ShowLine=Config.Aimlock.ShowLine, ShowDist=Config.Aimlock.ShowDist, LerpSpeed=Config.Aimlock.LerpSpeed, PersistentInfo=Config.Aimlock.PersistentInfo },
        ESP = Config.ESP,
        Movement = { Enabled=Config.Movement.Enabled, Key=Config.Movement.Key.Name, Speed=Config.Movement.Speed, JumpPower=Config.Movement.JumpPower, BypassJump=Config.Movement.BypassJump, Method=Config.Movement.Method },
    }
    return pcall(function() writefile(cfgPath(name), HttpService:JSONEncode(data)) end)
end

local function loadConfig(name)
    local ok, content = pcall(function() return readfile(cfgPath(name)) end)
    if not ok or not content then return false end
    local dec = HttpService:JSONDecode(content)
    if not dec then return false end
    if dec.SilentAim then
        local s = dec.SilentAim
        Config.SilentAim.Enabled = s.Enabled or false
        Config.SilentAim.FOV = s.FOV or 120
        Config.SilentAim.FOVVisible = s.FOVVisible ~= false
        Config.SilentAim.Bone = s.Bone or "Head"
        Config.SilentAim.WallCheck = s.WallCheck ~= false
        Config.SilentAim.Prediction = s.Prediction or 0.05
        Config.SilentAim.Method = s.Method or "Camera"
        Config.SilentAim.ShowRing = s.ShowRing ~= false
        Config.SilentAim.ShowLine = s.ShowLine ~= false
        Config.SilentAim.ShowDist = s.ShowDist ~= false
        if s.Key then local kc = Enum.KeyCode[s.Key]; if kc then Config.SilentAim.Key = kc end end
    end
    if dec.Aimlock then
        local a = dec.Aimlock
        Config.Aimlock.Enabled = a.Enabled or false
        Config.Aimlock.FOV = a.FOV or 90
        Config.Aimlock.Bone = a.Bone or "Head"
        Config.Aimlock.WallCheck = a.WallCheck ~= false
        Config.Aimlock.TeamCheck = a.TeamCheck ~= false
        Config.Aimlock.ShowFOV = a.ShowFOV ~= false
        Config.Aimlock.ShowRing = a.ShowRing ~= false
        Config.Aimlock.ShowLine = a.ShowLine ~= false
        Config.Aimlock.ShowDist = a.ShowDist ~= false
        Config.Aimlock.LerpSpeed = a.LerpSpeed or 0.25
        Config.Aimlock.PersistentInfo = a.PersistentInfo ~= false
        if a.Key then local kc = Enum.KeyCode[a.Key]; if kc then Config.Aimlock.Key = kc end end
    end
    if dec.ESP then
        Config.ESP.Enabled = dec.ESP.Enabled or false
        Config.ESP.Box = dec.ESP.Box or false
        Config.ESP.Skeleton = dec.ESP.Skeleton or false
        Config.ESP.Health = dec.ESP.Health or false
        Config.ESP.Name = dec.ESP.Name or false
        Config.ESP.Distance = dec.ESP.Distance or false
    end
    if dec.Movement then
        local m = dec.Movement
        Config.Movement.Enabled = m.Enabled or false
        Config.Movement.Speed = m.Speed or 32
        Config.Movement.JumpPower = m.JumpPower or 75
        Config.Movement.BypassJump = m.BypassJump ~= false
        Config.Movement.Method = m.Method or "Auto"
        if m.Key then local kc = Enum.KeyCode[m.Key]; if kc then Config.Movement.Key = kc end end
    end
    return true
end

local function listConfigs()
    ensureFolder()
    local ok, files = pcall(function() return listfiles(CFG_FOLDER) end)
    if not ok or not files then return {} end
    local out = {}
    for _, f in ipairs(files) do
        local n = f:match("([^/\\]+)%.json$")
        if n then table.insert(out, n) end
    end
    return out
end

local function deleteConfig(name)
    return pcall(function() delfile(cfgPath(name)) end)
end

