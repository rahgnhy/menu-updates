            if not (Config.ESP.Enabled and hrp and hum and hum.Health > 0) then
                d.root.Visible = false
                for _, l in ipairs(d.skeleton) do l.Visible = false end
                d.head.Visible = false
                return
            end

            local pos, onScreen = cam:WorldToViewportPoint(hrp.Position)
            if not onScreen then
                d.root.Visible = false
                for _, l in ipairs(d.skeleton) do l.Visible = false end
                d.head.Visible = false
                return
            end

            local topWorld = hrp.Position + Vector3.new(0, 3, 0)
            local botWorld = hrp.Position - Vector3.new(0, 3, 0)
            local topPos = cam:WorldToViewportPoint(topWorld)
            local botPos = cam:WorldToViewportPoint(botWorld)
            local h = math.abs(topPos.Y - botPos.Y)
            local w = h * 0.55

            if h < 3 or w < 3 then
                d.root.Visible = false
                for _, l in ipairs(d.skeleton) do l.Visible = false end
                d.head.Visible = false
                return
            end

            local bx = pos.X - w / 2
            local by = pos.Y - h / 2
            d.root.Position = UDim2.fromOffset(bx, by)
            d.root.Size = UDim2.fromOffset(w, h)
            d.root.Visible = true
            d.boxStroke.Thickness = math.clamp(h * 0.025, 1, 2)

            if Config.ESP.Box then
                d.box.Visible = true
                d.boxStroke.Transparency = 0
                if h >= 32 then
                    local cl = math.clamp(w * 0.30, 5, 20)
                    local th = 2
                    d.corners[1].Size = UDim2.fromOffset(cl, th); d.corners[1].Position = UDim2.fromOffset(0, 0); d.corners[1].Visible = true
                    d.corners[2].Size = UDim2.fromOffset(th, cl); d.corners[2].Position = UDim2.fromOffset(0, 0); d.corners[2].Visible = true
                    d.corners[3].Size = UDim2.fromOffset(cl, th); d.corners[3].Position = UDim2.new(1, -cl, 0, 0); d.corners[3].Visible = true
                    d.corners[4].Size = UDim2.fromOffset(th, cl); d.corners[4].Position = UDim2.new(1, -th, 0, 0); d.corners[4].Visible = true
                    d.corners[5].Size = UDim2.fromOffset(cl, th); d.corners[5].Position = UDim2.new(0, 0, 1, -th); d.corners[5].Visible = true
                    d.corners[6].Size = UDim2.fromOffset(th, cl); d.corners[6].Position = UDim2.new(0, 0, 1, -cl); d.corners[6].Visible = true
                    d.corners[7].Size = UDim2.fromOffset(cl, th); d.corners[7].Position = UDim2.new(1, -cl, 1, -th); d.corners[7].Visible = true
                    d.corners[8].Size = UDim2.fromOffset(th, cl); d.corners[8].Position = UDim2.new(1, -th, 1, -cl); d.corners[8].Visible = true
                else
                    for _, c in ipairs(d.corners) do c.Visible = false end
                end
            else
                d.box.Visible = false
                d.boxStroke.Transparency = 1
                for _, c in ipairs(d.corners) do c.Visible = false end
            end

            if Config.ESP.Skeleton then
                if not d.mode then d.mode = detectMode(char) end
                local conn = nil
                if d.mode == "R15" then conn = R15_CONN elseif d.mode == "R6" then conn = R6_CONN end
                if conn then
                    for i, pair in ipairs(conn) do
                        local pA = char:FindFirstChild(pair[1])
                        local pB = char:FindFirstChild(pair[2])
                        local line = d.skeleton[i]
                        if pA and pB then
                            local sa = cam:WorldToViewportPoint(pA.Position)
                            local sb = cam:WorldToViewportPoint(pB.Position)
                            line.From = Vector2.new(sa.X, sa.Y)
                            line.To = Vector2.new(sb.X, sb.Y)
                            line.Color = SKEL_COLOR
                            line.Transparency = 0
                            line.Visible = true
                        else line.Visible = false end
                    end
                    for i = #conn + 1, MAX_LINES do d.skeleton[i].Visible = false end
                    local headPart = char:FindFirstChild("Head")
                    if headPart then
                        local hp = cam:WorldToViewportPoint(headPart.Position)
                        local dist3 = (cam.CFrame.Position - headPart.Position).Magnitude
                        local headR = math.max((headPart.Size.Y * 0.5) * 100 / math.max(dist3, 1) * 1.2, 3)
                        d.head.Position = Vector2.new(hp.X, hp.Y)
                        d.head.Radius = headR
                        d.head.Visible = true
                    else d.head.Visible = false end
                else
                    for _, l in ipairs(d.skeleton) do l.Visible = false end
                    d.head.Visible = false
                end
            else
                for _, l in ipairs(d.skeleton) do l.Visible = false end
                d.head.Visible = false
            end

            if Config.ESP.Health then
                local targetPct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                d.animHP = d.animHP + (targetPct - d.animHP) * math.min(1, dt * 10)
                if math.abs(d.animHP - targetPct) < 0.002 then d.animHP = targetPct end
                local pct = d.animHP
                local barW = math.clamp(h * 0.035, 2, 4)
                local barOffset = barW + 3
                d.healthBG.Size = UDim2.fromOffset(barW, h)
                d.healthBG.Position = UDim2.new(0, -barOffset, 0, 0)
                d.healthBG.Visible = true
                d.healthFill.Size = UDim2.new(1, 0, pct, 0)
                local col
                if pct >= 0.5 then
                    local t = (1 - pct) * 2
                    col = Color3.fromRGB(math.floor(80 + 175 * t), math.floor(230 - 10 * t), math.floor(100 - 20 * t))
                else
                    local t = (0.5 - pct) * 2
                    col = Color3.fromRGB(255, math.floor(220 - 160 * t), math.floor(80 - 20 * t))
                end
                d.healthFill.BackgroundColor3 = col
            else d.healthBG.Visible = false end

            if Config.ESP.Name then
                local isTarget = Config.Target == player
                d.nameLbl.Text = isTarget and (player.Name .. "  <<") or player.Name
                d.nameLbl.TextColor3 = isTarget and Color3.fromRGB(255, 100, 120) or Color3.new(1, 1, 1)
                d.nameLbl.Visible = true
            else d.nameLbl.Visible = false end

            if Config.ESP.Distance then
                local dist = (cam.CFrame.Position - hrp.Position).Magnitude
                d.distLbl.Text = math.floor(dist) .. "m"
                d.distLbl.Visible = true
            else d.distLbl.Visible = false end
        end)
    end
end)

