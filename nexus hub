    local showReticleAim = Config.Aimlock.Enabled and Config.Aimlock.ShowRing
    local showReticleSilent = Config.SilentAim.Enabled and Config.SilentAim.ShowRing
    local showReticle = (showReticleAim or showReticleSilent) and hasTarget and Config.Target.Character and cam
    local showDistLabel = (Config.Aimlock.Enabled and Config.Aimlock.ShowDist) or (Config.SilentAim.Enabled and Config.SilentAim.ShowDist)

    if showReticle then
        if lockTarget ~= Config.Target then
            lockTarget = Config.Target; lockProgress = 0
        end
        lockProgress = math.min(1, lockProgress + dt * 4)
        local eased = 1 - (1 - lockProgress) ^ 3
        local boneName = Config.Aimlock.Enabled and Config.Aimlock.Bone or Config.SilentAim.Bone
        local bone = Config.Target.Character:FindFirstChild(boneName)
        if bone then
