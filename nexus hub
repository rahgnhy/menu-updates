local function aimActive() return (Config.SilentAim.Enabled or Config.Aimlock.Enabled) and not Killed end

local function isTeamMate(p)
    if not Config.Aimlock.TeamCheck then return false end
    return p.Team == LocalPlayer.Team and p.Team ~= nil
end

local function getClosestTarget(fov)
    if Killed then return nil end
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local mousePos = UIS:GetMouseLocation()
    local best, bestDist = nil, fov
    local myChar = LocalPlayer.Character
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and not isTeamMate(p) then
            local char = p.Character
            local bone = char:FindFirstChild(Config.SilentAim.Bone)
            local hum = char:FindFirstChildOfClass("Humanoid")
            if bone and hum and hum.Health > 0 then
                local screenPos, onScreen = cam:WorldToViewportPoint(bone.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    if dist < bestDist then
                        local blocked = false
                        if Config.SilentAim.WallCheck or Config.Aimlock.WallCheck then
                            rayParams.FilterDescendantsInstances = {myChar, char}
                            local origin = cam.CFrame.Position
                            local ray = workspace:Raycast(origin, bone.Position - origin, rayParams)
                            if ray then blocked = true end
                        end
                        if not blocked then best, bestDist = p, dist end
                    end
                end
            end
        end
    end
    return best
end

local SILENT_KW = {
    "shoot","fire","attack","hit","swing","damage","bullet","gun","weapon",
    "raycast","sword","punch","shot","projectile","trigger","combat",
    "click","slash","stab","pierce","cast","spell","ability","skill",
}

local function isShotRemote(remote)
    if typeof(remote) ~= "Instance" then return false end
    if not (remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction")) then return false end
    local n = remote.Name:lower()
    for _, kw in ipairs(SILENT_KW) do
        if n:find(kw, 1, true) then return true end
    end
    return false
end

local function redirectArgs(args, target)
    if not target or not target.Character then return args, false end
    local bone = target.Character:FindFirstChild(Config.SilentAim.Bone)
    local hrp = target.Character:FindFirstChild("HumanoidRootPart")
    if not bone then return args, false end
    local cam = workspace.CurrentCamera
    local origin = cam and cam.CFrame.Position or Vector3.new(0, 0, 0)
    local predicted = bone.Position
    if hrp then predicted = predicted + hrp.AssemblyLinearVelocity * Config.SilentAim.Prediction end
    local direction = predicted - origin

    local vecIdx = {}
    for i = 1, #args do
        if typeof(args[i]) == "Vector3" then table.insert(vecIdx, i) end
    end

    local changed = false
    if #vecIdx >= 2 then
        args[vecIdx[1]] = origin
        args[vecIdx[2]] = direction
        for k = 3, #vecIdx do args[vecIdx[k]] = predicted end
        changed = true
    elseif #vecIdx == 1 then
        args[vecIdx[1]] = predicted
        changed = true
    else
        for i = 1, #args do
            if typeof(args[i]) == "CFrame" then
                args[i] = CFrame.new(origin, predicted); changed = true
            elseif typeof(args[i]) == "table" then
                local v = args[i]
                if v.X and v.Y and v.Z then
                    v.X, v.Y, v.Z = predicted.X, predicted.Y, predicted.Z; changed = true
                elseif v.Position then
                    v.Position = predicted; changed = true
                elseif v.Direction then
                    v.Direction = direction; changed = true
                end
            end
        end
    end
    return args, changed
end

local directHooks = {}
local directInstalled = false
local envSanitizerInstalled = false
local oldGetFenv = nil

local function installEnvSanitizer()
    if envSanitizerInstalled then return end
    envSanitizerInstalled = true
    pcall(function()
        oldGetFenv = getfenv
        getfenv = newcclosure(function(level)
            if not oldGetFenv then return end
            local ok, env = pcall(oldGetFenv, level)
            if not ok then return oldGetFenv(level) end
            if level == 0 or level == 1 then
                return oldGetFenv(level)
            end
            return oldGetFenv(2)
        end)
    end)
end

local function installDirectHook()
    if directInstalled then return end
    if not hookfunction then return false end
    directInstalled = true
    local count = 0
    for _, obj in ipairs(RS:GetDescendants()) do
        if count >= 50 then break end
        if obj:IsA("RemoteEvent") and isShotRemote(obj) then
            local ok, old = pcall(function() return obj.FireServer end)
            if ok and old then
                pcall(function()
                    hookfunction(old, function(self, ...)
                        if Killed then return old(self, ...) end
                        if not Config.SilentAim.Enabled then return old(self, ...) end
                        local target = Config.Target
                        if target then
                            local args = { ... }
                            local newArgs, changed = redirectArgs(args, target)
                            if changed then return old(self, unpack(newArgs)) end
                        end
                        return old(self, ...)
                    end)
                    table.insert(directHooks, obj)
                    count = count + 1
                end)
            end
        end
    end
    return count > 0
end

local function uninstallDirectHook()
    if not directInstalled then return end
    directHooks = {}
    directInstalled = false
end

local namecallOld = nil
local namecallInstalled = false

local function installNamecallHook()
    if namecallInstalled then return end
    local ok = pcall(function()
        local mt = getrawmetatable(game)
        namecallOld = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            if Killed then return namecallOld(self, ...) end
            if not Config.SilentAim.Enabled or Config.SilentAim.Method ~= "Namecall" then
                return namecallOld(self, ...)
            end
            local method = getnamecallmethod()
            if (method == "FireServer" or method == "InvokeServer") and isShotRemote(self) then
                local target = Config.Target
                if target then
                    local args = { ... }
                    local newArgs, changed = redirectArgs(args, target)
                    if changed then return namecallOld(self, unpack(newArgs)) end
                end
            end
            return namecallOld(self, ...)
        end)
        setreadonly(mt, true)
        namecallInstalled = true
    end)
    return ok
end

local function uninstallNamecallHook()
    if not namecallInstalled then return end
    pcall(function()
        local mt = getrawmetatable(game)
        setreadonly(mt, false)
        mt.__namecall = namecallOld
        setreadonly(mt, true)
    end)
    namecallInstalled = false
end

local raycastHookInstalled = false
local raycastOldNamecall = nil

local function installRaycastHook()
    if raycastHookInstalled then return end
    local ok = pcall(function()
        local mt = getrawmetatable(game)
        raycastOldNamecall = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            if Killed then return raycastOldNamecall(self, ...) end
            if not Config.SilentAim.Enabled or Config.SilentAim.Method ~= "Raycast" then
                return raycastOldNamecall(self, ...)
            end
            local method = getnamecallmethod()
            if method == "Raycast" and self == workspace then
                local target = Config.Target
                if target and target.Character then
                    local bone = target.Character:FindFirstChild(Config.SilentAim.Bone)
                    if bone then
                        local args = { ... }
                        if #args >= 2 and typeof(args[1]) == "Vector3" and typeof(args[2]) == "Vector3" then
                            local origin = args[1]
                            args[2] = bone.Position - origin
                            return raycastOldNamecall(self, unpack(args))
                        end
                    end
                end
            end
            return raycastOldNamecall(self, ...)
        end)
        setreadonly(mt, true)
        raycastHookInstalled = true
    end)
    return ok
end

local function uninstallRaycastHook()
    if not raycastHookInstalled then return end
    pcall(function()
        local mt = getrawmetatable(game)
        setreadonly(mt, false)
        mt.__namecall = raycastOldNamecall
        setreadonly(mt, true)
    end)
    raycastHookInstalled = false
end

local function installCameraMethod()
    pcall(function() RunService:UnbindFromRenderStep("NexusSilentCamera") end)
    RunService:BindToRenderStep("NexusSilentCamera", Enum.RenderPriority.Camera.Value + 2, function(dt)
        if Killed then return end
        if not Config.SilentAim.Enabled then return end
        if Config.SilentAim.Method ~= "Camera" then return end
        local target = Config.Target
        if not target or not target.Character then return end
        local bone = target.Character:FindFirstChild(Config.SilentAim.Bone)
        local hum = target.Character:FindFirstChildOfClass("Humanoid")
        if not bone or not hum or hum.Health <= 0 then return end
        local cam = workspace.CurrentCamera
        if not cam then return end
        local camPos = cam.CFrame.Position
        local targetPos = bone.Position
        if Config.SilentAim.Prediction > 0 then
            local hrp = target.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                targetPos = targetPos + hrp.AssemblyLinearVelocity * Config.SilentAim.Prediction
            end
        end
        local desired = (targetPos - camPos).Unit
        local current = cam.CFrame.LookVector
        local smoothed = current:Lerp(desired, 0.35).Unit
        cam.CFrame = CFrame.lookAt(camPos, camPos + smoothed)
    end)
end

local function uninstallAllMethods()
    pcall(uninstallNamecallHook)
    pcall(uninstallRaycastHook)
    pcall(uninstallDirectHook)
    pcall(function() RunService:UnbindFromRenderStep("NexusSilentCamera") end)
end

