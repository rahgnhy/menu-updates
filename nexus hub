UIS.InputBegan:Connect(function(inp, gpe)
    if gpe then return end
    if Killed then return end
    if UIS:GetFocusedTextBox() then return end
    if inp.KeyCode == Enum.KeyCode.RightShift then
        ScreenGui.Enabled = not ScreenGui.Enabled
    elseif inp.KeyCode == Config.SilentAim.Key then
        Config.SilentAim.Enabled = not Config.SilentAim.Enabled
        if not Config.SilentAim.Enabled then Config.Target = nil end
        if toggleSetters["Enable Silent Aim"] then toggleSetters["Enable Silent Aim"](Config.SilentAim.Enabled) end
        UI:Notify("Silent Aim " .. (Config.SilentAim.Enabled and "ON" or "OFF"), 1.2)
    elseif inp.KeyCode == Config.Aimlock.Key then
        Config.Aimlock.Enabled = not Config.Aimlock.Enabled
        if not Config.Aimlock.Enabled then Config.Target = nil end
        if toggleSetters["Enable Aimlock"] then toggleSetters["Enable Aimlock"](Config.Aimlock.Enabled) end
        UI:Notify("Aimlock " .. (Config.Aimlock.Enabled and "ON" or "OFF"), 1.2)
    elseif inp.KeyCode == Config.Movement.Key then
        Config.Movement.Enabled = not Config.Movement.Enabled
        if toggleSetters["Enable Speed"] then toggleSetters["Enable Speed"](Config.Movement.Enabled) end
        UI:Notify("Speed " .. (Config.Movement.Enabled and "ON" or "OFF"), 1.2)
    end
end)

