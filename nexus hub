local MovementState = { attach = nil, lv = nil }
local function cleanupMovement()
    if MovementState.lv then pcall(function() MovementState.lv:Destroy() end); MovementState.lv = nil end
    if MovementState.attach then pcall(function() MovementState.attach:Destroy() end); MovementState.attach = nil end
end

local function ensureVelocity(hrp)
    if MovementState.lv and MovementState.lv.Parent == hrp then return end
    cleanupMovement()
    local attach = Instance.new("Attachment"); attach.Name = "NexusVelAttach"; attach.Parent = hrp
    local lv = Instance.new("LinearVelocity"); lv.Name = "NexusVelocity"
    lv.Attachment0 = attach
    lv.MaxForce = math.huge
    lv.RelativeTo = Enum.ActuatorRelativeTo.World
    pcall(function()
        lv.ForceLimitMode = Enum.ForceLimitMode.PerAxis
        lv.MaxAxes = Enum.Axis.XZ
    end)
    lv.VectorVelocity = Vector3.zero
    lv.Enabled = false
    lv.Parent = hrp
    MovementState.attach = attach
    MovementState.lv = lv
end

task.spawn(function()
    while not Killed do
        if Config.Movement.Enabled then
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hum and hrp then
                local m = Config.Movement.Method
                if m == "Auto" or m == "Humanoid" or m == "Persistent" then
                    pcall(function() hum.WalkSpeed = Config.Movement.Speed end)
                end
                if Config.Movement.BypassJump then
                    pcall(function()
                        hum.UseJumpPower = true
                        hum.JumpPower = Config.Movement.JumpPower
                    end)
                end
                if m == "Auto" or m == "Velocity" then
                    ensureVelocity(hrp)
                    if MovementState.lv then
                        local md = hum.MoveDirection
                        local flat = Vector3.new(md.X, 0, md.Z)
                        if flat.Magnitude > 0.01 then
                            MovementState.lv.Enabled = true
                            MovementState.lv.VectorVelocity = flat.Unit * Config.Movement.Speed
                        else
                            MovementState.lv.Enabled = false
                        end
                    end
                else
                    cleanupMovement()
                end
                if m == "CFrame" then
                    cleanupMovement()
                    local md = hum.MoveDirection
                    if md.Magnitude > 0.01 then
                        local target = md * Config.Movement.Speed
                        local curVel = hrp.AssemblyLinearVelocity
                        local horiz = Vector3.new(curVel.X, 0, curVel.Z)
                        local newVel = horiz:Lerp(target, 0.35)
                        pcall(function()
                            hrp.AssemblyLinearVelocity = Vector3.new(newVel.X, curVel.Y, newVel.Z)
                        end)
                    end
                end
            else
                cleanupMovement()
            end
        else
            cleanupMovement()
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then
                pcall(function() hum.WalkSpeed = 16 end)
                pcall(function()
                    hum.UseJumpPower = true
                    hum.JumpPower = 50
                end)
            end
        end
        task.wait(0.03)
    end
end)

