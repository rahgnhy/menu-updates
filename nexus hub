    d.head.Thickness=1.4; d.head.Filled=false; d.head.Color=P.Accent
    d.head.NumSides=24; d.head.Visible=false
    d.healthBG.Filled=true; d.healthBG.Color=Color3.fromRGB(18,14,26)
    d.healthFill.Filled=true; d.healthFill.Color=P.Success
    for i=1,MAX_LINES do
        local line=Drawing.new("Line")
        line.Thickness=1.6; line.Color=P.Accent; line.Visible=false
        d.skeleton[i]=line
    end
    ESPData[player]=d
end

local function destroyESP(player)
    local d=ESPData[player]
    if not d then return end
    d.box:Remove(); d.boxGlow:Remove(); d.name:Remove(); d.dist:Remove()
    d.head:Remove(); d.healthBG:Remove(); d.healthFill:Remove()
    for _,l in ipairs(d.skeleton) do l:Remove() end
    ESPData[player]=nil
end

local function hideAll(d)
    d.box.Visible=false; d.boxGlow.Visible=false
    d.name.Visible=false; d.dist.Visible=false; d.head.Visible=false
    d.healthBG.Visible=false; d.healthFill.Visible=false
    for _,l in ipairs(d.skeleton) do l.Visible=false end
end

local function detectMode(char)
    if char:FindFirstChild("UpperTorso") then return "R15" end
    if char:FindFirstChild("Torso") then return "R6" end
    return nil
end

for _,p in ipairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then createESP(p) end
end
Players.PlayerAdded:Connect(function(p) if p ~= LocalPlayer then createESP(p) end end)
Players.PlayerRemoving:Connect(destroyESP)

RunService.RenderStepped:Connect(function(dt)
    local cam = workspace.CurrentCamera
    if not cam then return end
    local t = tick()
    local espEnabled = Config.ESP.Enabled
    local fadeFactor = 1 - math.exp(-FADE_SPEED * dt)

    local mx,my,mw,mh
    if Main.Visible and Main.AbsoluteSize.X > 4 and Main.BackgroundTransparency < 0.95 then
        mx=Main.AbsolutePosition.X; my=Main.AbsolutePosition.Y
        mw=Main.AbsoluteSize.X; mh=Main.AbsoluteSize.Y
    end
    local function hitsMenu(x,y,w,h)
        if not mx then return false end
        return rectOverlap(x,y,w,h,mx,my,mw,mh)
    end

    for player,d in pairs(ESPData) do
        local char=player.Character
        local hrp=char and char:FindFirstChild("HumanoidRootPart")
        local hum=char and char:FindFirstChildOfClass("Humanoid")

        local canRender = espEnabled and hrp and hum and hum.Health>0
        local pos, onScreen
        if canRender then
            pos, onScreen = cam:WorldToViewportPoint(hrp.Position)
            if not onScreen then canRender = false end
        end

        local targetAlpha = canRender and 1 or 0
        d.alpha = d.alpha + (targetAlpha - d.alpha) * fadeFactor
        if math.abs(d.alpha - targetAlpha) < 0.005 then d.alpha = targetAlpha end

        if d.alpha <= 0.01 then
            hideAll(d)
        else
            local a = d.alpha
            local transparency = 1 - a

            local top = cam:WorldToViewportPoint(hrp.Position + Vector3.new(0,3,0))
            local bot = cam:WorldToViewportPoint(hrp.Position - Vector3.new(0,3,0))
            local h = math.abs(top.Y - bot.Y)
            local w = h * 0.55
            local cx, cy = pos.X, pos.Y
            local bx, by = cx - w/2, cy - h/2

            if Config.ESP.Box and not hitsMenu(bx,by,w,h) then
                d.box.Size = Vector2.new(w,h)
                d.box.Position = Vector2.new(bx,by)
                d.box.Transparency = transparency
                d.box.Visible = true
                if Config.ESP.Glow then
                    local pulse = Config.ESP.Pulse and (math.sin(t*4)*0.3+0.7) or 1
                    d.boxGlow.Size = Vector2.new(w+6,h+6)
                    d.boxGlow.Position = Vector2.new(bx-3,by-3)
                    d.boxGlow.Transparency = 1 - ((1-pulse)*0.5*a)
                    d.boxGlow.Visible = true
                else
                    d.boxGlow.Visible = false
                end
            else
                d.box.Visible = false
                d.boxGlow.Visible = false
            end

            if Config.ESP.Health then
                local pct = math.clamp(hum.Health/math.max(hum.MaxHealth,1), 0, 1)
                local barW, barX = 3, cx + w/2 + 5
                local barY = by
                if hitsMenu(barX-1, barY-1, barW+2, h+2) then
                    d.healthBG.Visible = false; d.healthFill.Visible = false
                else
                    d.healthBG.Size = Vector2.new(barW+2, h+2)
                    d.healthBG.Position = Vector2.new(barX-1, barY-1)
                    d.healthBG.Transparency = transparency
                    d.healthBG.Visible = true
                    local fillH = h * pct
                    d.healthFill.Size = Vector2.new(barW, fillH)
                    d.healthFill.Position = Vector2.new(barX, barY + (h - fillH))
                    d.healthFill.Color = Color3.fromRGB(
                        math.floor(255*(1-pct)), math.floor(215*pct+40), 80)
                    d.healthFill.Transparency = transparency
                    d.healthFill.Visible = true
                end
            else
                d.healthBG.Visible = false; d.healthFill.Visible = false
            end

            if Config.ESP.Skeleton and char then
                if not d.mode then d.mode = detectMode(char) end
                local conn, useDual = nil, false
                if d.mode == "R15" then conn = R15_CONN
                elseif d.mode == "R6" then conn = R6_CONN; useDual = true end

                if conn then
                    for i, pair in ipairs(conn) do
                        local pA, pB
                        if useDual then
                            pA = resolveBone(char, pair[1])
                            pB = resolveBone(char, pair[2])
                        else
                            pA = char:FindFirstChild(pair[1])
                            pB = char:FindFirstChild(pair[2])
                        end
                        local line = d.skeleton[i]
                        if pA and pB then
                            local sa = cam:WorldToViewportPoint(pA.Position)
                            local sb = cam:WorldToViewportPoint(pB.Position)
                            local lx = math.min(sa.X, sb.X)
                            local ly = math.min(sa.Y, sb.Y)
                            local lw = math.abs(sa.X - sb.X)
                            local lh = math.abs(sa.Y - sb.Y)
                            if hitsMenu(lx,ly,lw,lh) then
                                line.Visible = false
                            else
                                line.From = Vector2.new(sa.X, sa.Y)
                                line.To = Vector2.new(sb.X, sb.Y)
                                line.Color = P.Accent
                                line.Transparency = transparency
                                line.Visible = true
                            end
                        else
                            line.Visible = false
                        end
                    end
                    for i = #conn + 1, MAX_LINES do d.skeleton[i].Visible = false end

                    local headPart = char:FindFirstChild("Head")
                    if headPart then
                        local hp = cam:WorldToViewportPoint(headPart.Position)
                        local dist3 = (cam.CFrame.Position - headPart.Position).Magnitude
                        local headR = math.max((headPart.Size.Y*0.5) * 100 / math.max(dist3,1) * 1.2, 4)
                        if hitsMenu(hp.X-headR, hp.Y-headR, headR*2, headR*2) then
                            d.head.Visible = false
                        else
                            d.head.Position = Vector2.new(hp.X, hp.Y)
                            d.head.Radius = headR
                            d.head.Color = P.Accent
                            d.head.Transparency = transparency
                            d.head.Visible = true
                        end
                    else
                        d.head.Visible = false
                    end
                else
                    for _,l in ipairs(d.skeleton) do l.Visible = false end
                    d.head.Visible = false
                end
            else
                for _,l in ipairs(d.skeleton) do l.Visible = false end
                d.head.Visible = false
            end

            if Config.ESP.Name then
                local isTarget = Config.Target == player
                local txt = isTarget and (player.Name .. "  ◄") or player.Name
                local nx,ny,nw,nh = textBounds(cx, by-12, txt, 11)
                if hitsMenu(nx,ny,nw,nh) then
                    d.name.Visible = false
                else
                    d.name.Text = txt
                    d.name.Position = Vector2.new(cx, by-12)
                    d.name.Color = isTarget and P.Danger or Color3.new(1,1,1)
                    d.name.Transparency = transparency
                    d.name.Visible = true
                end
            else
                d.name.Visible = false
            end

            if Config.ESP.Distance then
                local dist = (cam.CFrame.Position - hrp.Position).Magnitude
                local txt = math.floor(dist) .. "m"
                local dx,dy,dw,dh = textBounds(cx, by+h+2, txt, 10)
                if hitsMenu(dx,dy,dw,dh) then
                    d.dist.Visible = false
                else
                    d.dist.Text = txt
                    d.dist.Position = Vector2.new(cx, by+h+2)
                    d.dist.Transparency = transparency
                    d.dist.Visible = true
                end
            else
                d.dist.Visible = false
            end
        end
    end
end)

