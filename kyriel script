local lastGunApply=0
bind(RunService.Stepped:Connect(function()
    if not alive then return end
    local c=ch()

    if cfg.on.noclip then updateNoclip() end

    if cfg.on.antiFall and hum() then
        local h2=hum()
        h2:SetStateEnabled(Enum.HumanoidStateType.FallingDown,false)
        h2:SetStateEnabled(Enum.HumanoidStateType.Ragdoll,false)
    end

    if c then
        for _,v in ipairs(c:GetDescendants()) do
            local n=v.Name:lower()
            if cfg.on.antiRiotShield and (n:find("shield") or n:find("riot"))  then pcall(function() v:Destroy() end) end
            if cfg.on.antiTaze       and (n:find("taze")  or n:find("stun"))   then pcall(function() v:Destroy() end) end
            if cfg.on.antiCuff       and (n:find("cuff")  or n=="handcuffs")   then pcall(function() v:Destroy() end) end
        end
        if cfg.on.antiTaze and hum() and cfg.on.speedHack then
            local h2=hum()
            if h2.WalkSpeed<_targetSpd*0.75 then h2.WalkSpeed=_targetSpd end
        end
    end

    if cfg.on.fenceGod and hum() then
        local h2=hum() if h2.Health<h2.MaxHealth then h2.Health=h2.MaxHealth end
    end

    -- Auto arrest: equip cuffs then fire if in range
    if cfg.on.autoArrest and root() and isGuard(lp) then
        local r2=root()
        for _,p in ipairs(Players:GetPlayers()) do
            if isArrestable(p) and p.Character then
                local pr=p.Character:FindFirstChild("HumanoidRootPart")
                if pr and (r2.Position-pr.Position).Magnitude<=cfg.arrestRange then
                    if equipCuffs() then
                        task.delay(0.1,function() arrestPlayer(p) end)
                    end
                end
            end
        end
    end

    -- Auto taser: targets criminals/wanted only, not police
    if cfg.on.autoTaser and root() then
        local r2=root() local c2=ch()
        local taser=nil
        if c2 then taser=c2:FindFirstChild("Taser") end
        if not taser then
            local bp=lp:FindFirstChild("Backpack")
            if bp then taser=bp:FindFirstChild("Taser") end
        end
        if taser and c2 then
            if taser.Parent~=c2 then taser.Parent=c2 end
            for _,p in ipairs(Players:GetPlayers()) do
                if isArrestable(p) and p.Character then
                    local pr=p.Character:FindFirstChild("HumanoidRootPart")
                    if pr and (r2.Position-pr.Position).Magnitude<40 then
                        pcall(function() taser:Activate() end)
                        local re=taser:FindFirstChildWhichIsA("RemoteEvent")
                        if re then pcall(function() re:FireServer(pr.Position) end) end
                    end
                end
            end
        end
    end

    -- Gun mods: apply every 0.35s
    if cfg.on.gunMods then
        local now=os.clock()
        local c2=ch()
        local tool=c2 and c2:FindFirstChildWhichIsA("Tool")
        if tool and now-lastGunApply>0.35 then
            lastGunApply=now
            applyGunMods(tool)
        end
        -- Rapid fire
        if tool and cfg.fullAuto and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
            for _=1,math.clamp(cfg.fireRate,1,6) do
                pcall(function() tool:Activate() end)
            end
        end
    end

    -- Auto pickup
    if cfg.on.autoPickup and os.clock()-lastPickup>0.3 then
        lastPickup=os.clock() doAutoPickup()
    end
end))

