-- ══════════════ RENDER LOOP ══════════════
local lastTrig=0
bind(RunService.RenderStepped:Connect(function()
    if not alive then return end
    cam=workspace.CurrentCamera
    espPulseT=espPulseT+0.04
    rainbowHue=(rainbowHue+0.004)%1

    if fovC then
        fovC.Visible=cfg.on.silentAim and cfg.saCircle
        if fovC.Visible then fovC.Position=center() fovC.Radius=cfg.saFov*4 end
    end

    if cfg.on.autoLock and locked then
        local part=aimPart(locked)
        local h2=locked.Character and locked.Character:FindFirstChildOfClass("Humanoid")
        if not part or not h2 or h2.Health<=0 then locked=nil
        else cam.CFrame=CFrame.new(cam.CFrame.Position,part.Position) end
    end

    if cfg.on.triggerBot then
        local now=os.clock()
        if now-lastTrig>=0.05 then
            local pl=aimedDirect()
            if pl then
                lastTrig=now
                local tool=ch() and ch():FindFirstChildWhichIsA("Tool")
                if tool then pcall(function() tool:Activate() end) end
            end
        end
    end

    local espCol = cfg.espRainbow and Color3.fromHSV(rainbowHue,0.85,1) or A

    for _,p in ipairs(Players:GetPlayers()) do
        local e=esp[p] local c=p.Character
        local r2=c and c:FindFirstChild("HumanoidRootPart")
        local h2=c and c:FindFirstChildOfClass("Humanoid")

        if e then
            if cfg.on.esp and r2 and h2 and h2.Health>0 then
                local topV,on=scr(r2.Position+Vector3.new(0,3.1,0))
                local botV=select(1,scr(r2.Position-Vector3.new(0,3.0,0)))
                if on then
                    local ht=math.abs(topV.Y-botV.Y)
                    local w=ht*0.52
                    local cx=topV.X local cy=topV.Y
                    local pct=h2.Health/h2.MaxHealth
                    local col=pct<0.4 and Color3.fromRGB(255,70,70) or espCol
                    local pulse=cfg.espPulse and (1+math.sin(espPulseT)*0.06) or 1
                    local pw=w*pulse local pht=ht*pulse

                    if cfg.espStyle=="box" then
                        e.outline.Size=Vector2.new(pw+3,pht+3)
                        e.outline.Position=Vector2.new(cx-(pw+3)/2,cy-1)
                        e.outline.Visible=true
                        e.box.Size=Vector2.new(pw,pht)
                        e.box.Position=Vector2.new(cx-pw/2,cy)
                        e.box.Color=col e.box.Visible=true
                        for _,l in ipairs(e.corners) do l.Visible=false end
                    elseif cfg.espStyle=="corner" then
                        e.box.Visible=false e.outline.Visible=false
                        local cl=pw*0.30
                        local x1=cx-pw/2 local x2=cx+pw/2
                        local y1=cy local y2=cy+pht
                        e.corners[1].From=Vector2.new(x1,y1) e.corners[1].To=Vector2.new(x1+cl,y1) e.corners[1].Color=col e.corners[1].Visible=true
                        e.corners[2].From=Vector2.new(x1,y1) e.corners[2].To=Vector2.new(x1,y1+cl) e.corners[2].Color=col e.corners[2].Visible=true
                        e.corners[3].From=Vector2.new(x2,y1) e.corners[3].To=Vector2.new(x2-cl,y1) e.corners[3].Color=col e.corners[3].Visible=true
                        e.corners[4].From=Vector2.new(x2,y1) e.corners[4].To=Vector2.new(x2,y1+cl) e.corners[4].Color=col e.corners[4].Visible=true
                        e.corners[5].From=Vector2.new(x1,y2) e.corners[5].To=Vector2.new(x1+cl,y2) e.corners[5].Color=col e.corners[5].Visible=true
                        e.corners[6].From=Vector2.new(x1,y2) e.corners[6].To=Vector2.new(x1,y2-cl) e.corners[6].Color=col e.corners[6].Visible=true
                        e.corners[7].From=Vector2.new(x2,y2) e.corners[7].To=Vector2.new(x2-cl,y2) e.corners[7].Color=col e.corners[7].Visible=true
                        e.corners[8].From=Vector2.new(x2,y2) e.corners[8].To=Vector2.new(x2,y2-cl) e.corners[8].Color=col e.corners[8].Visible=true
                    end

                    -- health bar
                    local bx=cx-pw/2-7
                    local barH=pht*pct
                    e.hBG.Size=Vector2.new(4,pht) e.hBG.Position=Vector2.new(bx,cy) e.hBG.Visible=true
                    e.hBar.Size=Vector2.new(4,barH) e.hBar.Position=Vector2.new(bx,cy+pht-barH)
                    e.hBar.Color=Color3.fromRGB(math.floor((1-pct)*255),math.floor(pct*200),50) e.hBar.Visible=true
                else
                    e.box.Visible=false e.outline.Visible=false e.hBG.Visible=false e.hBar.Visible=false
                    for _,l in ipairs(e.corners) do l.Visible=false end
                end
            else
                e.box.Visible=false e.outline.Visible=false e.hBG.Visible=false e.hBar.Visible=false
                for _,l in ipairs(e.corners) do l.Visible=false end
            end
        end

        local tg=tags[p]
        if tg then
            if cfg.on.nameTags and r2 and h2 and h2.Health>0 then
                local sp2,on2=scr(r2.Position+Vector3.new(0,3.8,0))
                if on2 then
                    tg.Position=sp2
                    if cfg.tagStyle=="minimal" then tg.Text=p.Name
                    elseif cfg.tagStyle=="full" then
                        local dist=math.floor((cam.CFrame.Position-r2.Position).Magnitude)
                        tg.Text=string.format("[%s | %d❤ | %dm]",p.Name,math.floor(h2.Health),dist)
                    else
                        tg.Text=string.format("%s [%d]",p.Name,math.floor(h2.Health))
                    end
                    tg.Color=cfg.espRainbow and Color3.fromHSV(rainbowHue,0.85,1) or A
                    tg.Visible=true
                else tg.Visible=false end
            else tg.Visible=false end
        end
    end
end))

