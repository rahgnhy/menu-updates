local function loadConfig()
    if isfile and readfile and isfile(CFG_FILE) then
        local ok, data = pcall(function()
            return HttpService:JSONDecode(readfile(CFG_FILE))
        end)
        if ok and type(data) == "table" then
            for k, v in pairs(data) do
                cfg[k] = v
            end
        end
    end
    if type(cfg.on) ~= "table" then cfg.on = {} end
    if type(cfg.windows) ~= "table" then cfg.windows = {} end
    for _, k in ipairs(TOGGLES) do
        if cfg.on[k] == nil then
            cfg.on[k] = false
        end
    end
end

local function saveConfig()
    if writefile then
        pcall(function()
            writefile(CFG_FILE, HttpService:JSONEncode(cfg))
        end)
    end
end

