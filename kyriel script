            extra.Visible=true extra.Size=UDim2.new(1,0,0,0)
            -- measure content
            local h2=0
            for _,c in ipairs(extra:GetChildren()) do
                if c:IsA("Frame") then h2=h2+(c.AbsoluteSize.Y>0 and c.AbsoluteSize.Y or 40) end
            end
            h2=math.max(h2,40)
            TweenSvc:Create(extra,TweenInfo.new(0.2,Enum.EasingStyle.Quart),{Size=UDim2.new(1,0,0,h2)}):Play()
        end
        settBtn.MouseButton1Click:Connect(openSett)
    end

    local clickW=buildSettings and UDim2.new(1,-30,1,0) or UDim2.new(1,0,1,0)
    local clickArea=Instance.new("TextButton")
    clickArea.Size=clickW clickArea.BackgroundTransparency=1
