trackConnection(RunService.Stepped:Connect(function()
    if not isAlive then return end
    local char = getCharacter(LocalPlayer)

    if cfg.on.noclip and char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end

    if cfg.on.antiFall then
        local hum = getHumanoid(LocalPlayer)
        if hum then
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        end
    end

    if char then
        for _, item in ipairs(char:GetDescendants()) do
            local name = item.Name:lower()
            if cfg.on.antiRiotShield and (name:find("shield") or name:find("riot")) then
                pcall(function() item:Destroy() end)
            end
            if cfg.on.antiTaze and (name:find("taze") or name:find("stun")) then
                pcall(function() item:Destroy() end)
            end
            if cfg.on.antiCuff and (name:find("cuff") or name == "handcuffs") then
                pcall(function() item:Destroy() end)
            end
        end
    end

    if cfg.on.fenceGod then
        local hum = getHumanoid(LocalPlayer)
        if hum and hum.Health < hum.MaxHealth then
            hum.Health = hum.MaxHealth
        end
    end

    if cfg.on.autoArrest then
        local rootPart = getRoot(LocalPlayer)
        if rootPart and isLocalGuard() then
            for _, p in ipairs(Players:GetPlayers()) do
                if isPlayerArrestable(p) and p.Character then
                    local targetRoot = getRoot(p)
                    if targetRoot and (rootPart.Position - targetRoot.Position).Magnitude <= cfg.arrestRange then
                        if equipHandcuffs() then
                            task.delay(0.08, function() requestArrest(p) end)
                        end
                    end
                end
            end
        end
    end

    if cfg.on.autoTaser then
        local rootPart = getRoot(LocalPlayer)
        if rootPart then
            local char  = getCharacter(LocalPlayer)
            local taser = char and char:FindFirstChild("Taser")
            if not taser then
                local bp = LocalPlayer:FindFirstChild("Backpack")
                if bp then taser = bp:FindFirstChild("Taser") end
            end
            if taser and char then
                if taser.Parent ~= char then taser.Parent = char end
                for _, p in ipairs(Players:GetPlayers()) do
                    if isPlayerArrestable(p) and p.Character then
                        local targetRoot = getRoot(p)
                        if targetRoot and (rootPart.Position - targetRoot.Position).Magnitude < 40 then
                            pcall(function() taser:Activate() end)
                            local re = taser:FindFirstChildWhichIsA("RemoteEvent")
                            if re then pcall(function() re:FireServer(targetRoot.Position) end) end
                        end
                    end
                end
            end
        end
    end

    if cfg.on.gunMods then
        local now  = os.clock()
        local char = getCharacter(LocalPlayer)
        local gun  = char and char:FindFirstChildWhichIsA("Tool")

        if gun and now - lastGunModTick > 0.3 then
            lastGunModTick = now
            pcall(function()
                for _, moduleScript in ipairs(gun:GetChildren()) do
                    if moduleScript:IsA("ModuleScript") and moduleScript.Name:find("GunStates") then
                        local mod = require(moduleScript)
                        if type(mod) == "table" then
                            if cfg.noSpread then
                                mod.Spread       = 0
                                mod.MaxSpread    = 0
                                mod.MinSpread    = 0
                                mod.RecoilSpread = 0
                                mod.AimSpread    = 0
                            end
                            if cfg.fullAuto then
                                mod.AutoFire      = true
                                mod.Automatic     = true
                                mod.SemiAutomatic = false
                            end
                            if cfg.infAmmo then
                                mod.CurrentAmmo = 999
                                mod.MaxAmmo     = 999
                                mod.StoredAmmo  = 999
                            end
                        end
                    end
                end
            end)
        end

        if gun and cfg.fullAuto and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
            for _ = 1, math.clamp(cfg.fireRate, 1, 8) do
                pcall(function() gun:Activate() end)
            end
        end
    end

    if cfg.on.autoPickup and os.clock() - lastPickupTick > 0.35 then
        lastPickupTick = os.clock()
        local rootPart = getRoot(LocalPlayer)
        if rootPart then
            for _, item in ipairs(Workspace:GetDescendants()) do
                if isGroundTool(item) and item:FindFirstChild("Handle") then
                    local dist = (rootPart.Position - item.Handle.Position).Magnitude
                    if dist <= cfg.pickupRange then
                        pcall(function() item.Parent = LocalPlayer.Backpack end)
                    end
                end
            end
        end
    end
end))

