local function getAimTargetPart(player)
    local char = getCharacter(player)
    if not char then return nil end
    if cfg.saHead then
        local head = char:FindFirstChild("Head")
        if head then return head end
    end
    return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
end

local function isVisibleTarget(targetPart)
    if not cfg.saVis then return true end
    local origin = Camera.CFrame.Position
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {getCharacter(LocalPlayer)}
    params.FilterType = Enum.RaycastFilterType.Exclude
    local hit = Workspace:Raycast(origin, targetPart.Position - origin, params)
    if not hit then return true end
    if hit.Instance then
        return hit.Instance:IsDescendantOf(targetPart.Parent)
    end
    return false
end

local function getClosestPlayerToCursor(fovLimit)
    local mousePos = Vector2.new(Mouse.X, Mouse.Y)
    local bestPlr  = nil
    local bestDist = fovLimit
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local part = getAimTargetPart(p)
            local hum  = getHumanoid(p)
            if part and hum and hum.Health > 0 then
                local sPos, onScreen = screenPosition(part.Position)
                if onScreen then
                    local dist = (sPos - mousePos).Magnitude
                    if dist < bestDist and isVisibleTarget(part) then
                        bestDist = dist
                        bestPlr  = p
                    end
                end
            end
        end
    end
    return bestPlr, bestDist
end

local function equipHandcuffs()
    local char = getCharacter(LocalPlayer)
    local bp   = LocalPlayer:FindFirstChild("Backpack")
    if not char then return false end
    local held = char:FindFirstChildWhichIsA("Tool")
    if held and held.Name:lower():find("cuff") then return true end
    if bp then
        for _, item in ipairs(bp:GetChildren()) do
            if item:IsA("Tool") and item.Name:lower():find("cuff") then
                item.Parent = char
                task.wait(0.08)
                return true
            end
        end
    end
    return false
end

local function requestArrest(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return end
