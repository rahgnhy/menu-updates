local PRIO={"remington","shotgun","ak-47","ak","m4a1","m4","m9","pistol"}
local function doHotbar()
    if hotbarBusy then return end hotbarBusy=true
    task.defer(function()
        local bp=lp:FindFirstChild("Backpack") if bp then
            local guns={}
            for _,t in ipairs(bp:GetChildren()) do if t:IsA("Tool") then table.insert(guns,t) end end
            table.sort(guns,function(a,b)
                local pa,pb=99,99
                for i,k in ipairs(PRIO) do
                    if a.Name:lower():find(k) then pa=math.min(pa,i) end
                    if b.Name:lower():find(k) then pb=math.min(pb,i) end
                end return pa<pb
            end)
            for _,t in ipairs(guns) do t.Parent=nil end
            for _,t in ipairs(guns) do t.Parent=bp end
        end task.wait(1) hotbarBusy=false
    end)
