    acc.BackgroundColor3=cfg.on[id] and A or Color3.fromRGB(42,48,56)
    acc.BorderSizePixel=0 acc.Parent=item corner(acc,2)

    local lbl=Instance.new("TextLabel") lbl.Name="Lbl"
    lbl.BackgroundTransparency=1 lbl.Size=UDim2.new(1,-40,1,0)
    lbl.Position=UDim2.new(0,12,0,0) lbl.Font=Enum.Font.Gotham
    lbl.TextSize=13 lbl.TextXAlignment=Enum.TextXAlignment.Left
    lbl.TextColor3=cfg.on[id] and W or FG lbl.Text=label lbl.Parent=item

    local settDot=Instance.new("TextLabel") settDot.BackgroundTransparency=1
    settDot.Size=UDim2.new(0,26,1,0) settDot.Position=UDim2.new(1,-28,0,0)
    settDot.Font=Enum.Font.GothamBold settDot.TextSize=15
    settDot.TextColor3=buildSett and MUTED or Color3.fromRGB(30,36,44)
    settDot.Text=buildSett and "⋮" or "" settDot.Parent=item

    local settPanel=nil
    if buildSett then
        settPanel=Instance.new("Frame") settPanel.Name="SettPanel"
        settPanel.Size=UDim2.new(1,0,0,0) settPanel.ClipsDescendants=true
        settPanel.BackgroundColor3=Color3.fromRGB(11,13,15) settPanel.BorderSizePixel=0
        settPanel.Visible=false settPanel.Parent=parent
        local sl=Instance.new("UIListLayout") sl.SortOrder=Enum.SortOrder.LayoutOrder sl.Parent=settPanel
        buildSett(settPanel)
        sl:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            if settPanel.Visible then settPanel.Size=UDim2.new(1,0,0,sl.AbsoluteContentSize.Y) end
        end)
    end

    -- Left area = toggle
    local leftW=buildSett and UDim2.new(1,-30,1,0) or UDim2.new(1,0,1,0)
    local leftBtn=Instance.new("TextButton")
    leftBtn.Size=leftW leftBtn.BackgroundTransparency=1 leftBtn.Text="" leftBtn.ZIndex=5 leftBtn.AutoButtonColor=false leftBtn.Parent=item
    leftBtn.MouseButton1Click:Connect(function()
        local ns=not cfg.on[id]
        playSound(ns and SND.on or SND.off)
        doAnim(item, ns and A or Color3.fromRGB(180,55,55))
        setOn(id,ns)
    end)
    addHover(leftBtn,ROW2,cfg.on[id] and ON or ROW)

    -- Right ⋮ area = settings
    if buildSett and settPanel then
        local rightBtn=Instance.new("TextButton")
        rightBtn.Size=UDim2.new(0,30,1,0) rightBtn.Position=UDim2.new(1,-30,0,0)
        rightBtn.BackgroundTransparency=1 rightBtn.Text="" rightBtn.ZIndex=5 rightBtn.AutoButtonColor=false rightBtn.Parent=item
        rightBtn.MouseButton1Click:Connect(function()
            playSound(SND.click)
            if openSett==settPanel then closeSett() settDot.TextColor3=MUTED return end
            closeSett()
            openSett=settPanel settDot.TextColor3=A
            settPanel.Visible=true settPanel.Size=UDim2.new(1,0,0,0)
            local sl2=settPanel:FindFirstChildOfClass("UIListLayout")
            local targetH=sl2 and sl2.AbsoluteContentSize.Y or 60
            TweenSvc:Create(settPanel,TweenInfo.new(0.24,Enum.EasingStyle.Quart),{
                Size=UDim2.new(1,0,0,targetH)
            }):Play()
        end)
        addHover(rightBtn,ROW2,cfg.on[id] and ON or ROW)
    end

    if cfg.on[id] then setOn(id,true) end
    return item
end

