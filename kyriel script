local function setWalkSpeed(v)
    _targetSpeed = v
    local h2 = hum()
    if not h2 then return end
    local start = h2.WalkSpeed
    for i = 1, 10 do
        task.delay(i * 0.05, function()
            local hh = hum()
            if hh then
                hh.WalkSpeed = start + (v - start) * (i / 10)
            end
        end)
    end
end

local function setJumpPower(v)
    _targetJump = v
    local h2 = hum()
    if not h2 then return end
    h2.UseJumpPower = true
    local start = h2.JumpPower
    for i = 1, 8 do
        task.delay(i * 0.04, function()
            local hh = hum()
            if hh then
                hh.UseJumpPower = true
                hh.JumpPower = start + (v - start) * (i / 8)
            end
        end)
    end
end

local function getTeamName(p)
    local t = p.Team
    if not t then return "default" end
    local tc = t.TeamColor
    if tc == BrickColor.new("Bright blue")   then return "police" end
    if tc == BrickColor.new("Bright orange") then return "prisoner" end
    if tc == BrickColor.new("Really red")    then return "criminal" end
    local n = t.Name:lower()
    if n:find("guard") or n:find("police")   then return "police" end
    if n:find("criminal")                    then return "criminal" end
    if n:find("inmate") or n:find("prisoner")then return "prisoner" end
    return "default"
end

local function isArrestable(p)
    if p == lp or not p.Character then return false end
    local tn = getTeamName(p)
    return tn == "criminal" or tn == "prisoner"
end

local function isGuard(p)
