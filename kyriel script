local navState={} -- track which windows are shown for dot indicator

local function setWindowVisible(title, open, animate)
    local w=windows[title] if not w then return end
    cfg.winOpen[title]=open saveCfg()
    local ns=navState[title]

    if open then
        w.Visible=true
        if animate then
            w.Size=UDim2.new(0,232,0,0)
            w.BackgroundTransparency=1
            local list2=w:FindFirstChildOfClass("UIListLayout")
            local targetH=list2 and list2.AbsoluteContentSize.Y+2 or 200
            TweenSvc:Create(w,TweenInfo.new(0.32,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{
                Size=UDim2.new(0,232,0,targetH),BackgroundTransparency=0
            }):Play()
        end
        if ns then
            ns.dot.Visible=true
            TweenSvc:Create(ns.iL,TweenInfo.new(0.12),{TextColor3=A}):Play()
            TweenSvc:Create(ns.nL,TweenInfo.new(0.12),{TextColor3=FG}):Play()
        end
    else
        if animate then
            TweenSvc:Create(w,TweenInfo.new(0.2,Enum.EasingStyle.Quart,Enum.EasingDirection.In),{
                Size=UDim2.new(0,232,0,0),BackgroundTransparency=1
            }):Play()
            task.delay(0.22,function() w.Visible=false w.BackgroundTransparency=0 end)
        else
            w.Visible=false
        end
        if ns then
            ns.dot.Visible=false
            TweenSvc:Create(ns.iL,TweenInfo.new(0.12),{TextColor3=MUTED}):Play()
            TweenSvc:Create(ns.nL,TweenInfo.new(0.12),{TextColor3=MUTED}):Play()
        end
    end
end

