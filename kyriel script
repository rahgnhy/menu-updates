-- ══ TEAM ══
local function teamOf(p)
    local t=p.Team if not t then return "default" end
    local tc=t.TeamColor
    if tc==BrickColor.new("Bright blue")   then return "police"   end
    if tc==BrickColor.new("Bright orange") then return "prisoner" end
    if tc==BrickColor.new("Really red")    then return "criminal"  end
    local n=t.Name:lower()
    if n:find("guard") or n:find("police")  then return "police"   end
    if n:find("criminal")                   then return "criminal"  end
    if n:find("inmate") or n:find("prisoner")then return "prisoner" end
    return "default"
end
local function isArrestable(p)
    if p==lp or not p.Character then return false end
    local tn=teamOf(p)
    return tn=="criminal" or tn=="prisoner"
end
local function isGuard(p)   return teamOf(p)=="police" end

