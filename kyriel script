    valText.Parent         = frame

    local track = Instance.new("Frame")
    track.Size             = UDim2.new(1, -20, 0, 4)
    track.Position         = UDim2.new(0, 10, 0, 32)
    track.BackgroundColor3 = BORDER_COLOR
    track.BorderSizePixel  = 0
    track.Parent           = frame
    roundCorners(track, 3)

    local initialRel = math.clamp((getter() - minV) / math.max(1, maxV - minV), 0, 1)

    local fill = Instance.new("Frame")
    fill.Size             = UDim2.new(initialRel, 0, 1, 0)
    fill.BackgroundColor3 = ACCENT_COLOR
    fill.BorderSizePixel  = 0
    fill.Parent           = track
    roundCorners(fill, 3)

    local thumb = Instance.new("Frame")
    thumb.Size             = UDim2.new(0, 12, 0, 12)
    thumb.Position         = UDim2.new(initialRel, -6, 0.5, -6)
    thumb.BackgroundColor3 = WHITE
    thumb.BorderSizePixel  = 0
    thumb.Parent           = track
    roundCorners(thumb, 6)

    local hit = Instance.new("TextButton")
    hit.BackgroundTransparency = 1
    hit.Size     = UDim2.new(1, 0, 4, 0)
    hit.Position = UDim2.new(0, 0, -1.5, 0)
    hit.Text     = ""
    hit.Parent   = track

    local isSliding = false
    hit.MouseButton1Down:Connect(function() isSliding = true end)
    trackConnection(UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then isSliding = false end
    end))
    trackConnection(UserInputService.InputChanged:Connect(function(i)
        if isSliding and i.UserInputType == Enum.UserInputType.MouseMovement then
            local rel = math.clamp((i.Position.X - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
            local val = math.floor(minV + (maxV - minV) * rel + 0.5)
            setter(val)
            valText.Text = tostring(val)
            fill.Size = UDim2.new(rel, 0, 1, 0)
            thumb.Position = UDim2.new(rel, -6, 0.5, -6)
            saveConfig()
        end
    end))
end

