local function setOn(id, state)
    cfg.on[id] = state
    saveCfg()
    local row = rows[id]
    if row then
        TweenSvc:Create(row, TweenInfo.new(0.2), {
            BackgroundColor3 = state and ON or ROW
        }):Play()
        local acc = row:FindFirstChild("Acc")
        if acc then
            TweenSvc:Create(acc, TweenInfo.new(0.2), {
                BackgroundColor3 = state and A or Color3.fromRGB(45, 50, 60)
            }):Play()
        end
        local lbl = row:FindFirstChild("Lbl")
        if lbl then
            TweenSvc:Create(lbl, TweenInfo.new(0.1), {
                TextColor3 = state and W or FG
            }):Play()
        end
    end
    if id == "fullbright"   then setFullbright(state) end
    if id == "chams"        then
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character then
                local ex = p.Character:FindFirstChild("_KyChams")
                if state and not ex then
                    applyChams(p)
                elseif not state and ex then
                    ex:Destroy()
                end
            end
        end
    end
    if id == "fly" and not state then
        local h2 = hum()
        if h2 then h2.PlatformStand = false end
    end
    if id == "autoLock" and not state then locked = nil end
    if id == "speedHack" and not state then
        local h2 = hum()
        if h2 then h2.WalkSpeed = 16 end
    end
    if id == "infJump" and not state then
        local h2 = hum()
        if h2 then
            h2.UseJumpPower = true
            h2.JumpPower    = 50
        end
    end
    if id == "noclip" and not state then
        local c = ch()
        if c then
            for _, p in ipairs(c:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = true end
            end
        end
    end
end

