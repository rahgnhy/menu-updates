local function watchKills(p)
    if p==lp then return end
    local function hook(c)
        local h2=c:WaitForChild("Humanoid",8) if not h2 then return end
        bind(h2.Died:Connect(function()
            if not cfg.on.killNotifs then return end
            local tag=h2:FindFirstChild("creator") or h2:FindFirstChild("Creator")
            local v=tag and tag.Value
            if v==lp or (typeof(v)=="Instance" and v.Name==lp.Name) then
                pushKill(p.DisplayName or p.Name)
            end
        end))
    end
    if p.Character then task.spawn(hook,p.Character) end
    bind(p.CharacterAdded:Connect(hook))
end
for _,p in ipairs(Players:GetPlayers()) do watchKills(p) end
