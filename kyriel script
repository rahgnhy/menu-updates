local function fetchItemGiver(itemName)
    pcall(function()
        local giverFolder = Workspace:FindFirstChild("Prison_ITEMS")
        if giverFolder and giverFolder:FindFirstChild("giver") then
            local giver = giverFolder.giver:FindFirstChild(itemName)
            if giver and giver:FindFirstChild("ITEMPICKUP") then
                Workspace.Remote.ItemHandler:InvokeServer(giver.ITEMPICKUP)
            end
        end
    end)
end

local function fetchAnyGun()
    local function searchFolder(folder)
        if not folder then return nil end
        for _, item in ipairs(folder:GetChildren()) do
            if item:IsA("Tool") and (item:FindFirstChild("GunStates") or item:FindFirstChild("GunStates_M4A1") or item:FindFirstChild("GunStates_AK47")) then
                return item
            end
        end
        return nil
    end
    local char = getCharacter(LocalPlayer)
    local bp   = LocalPlayer:FindFirstChild("Backpack")
    local gun  = searchFolder(char) or searchFolder(bp)
    return gun
end

local function installSilentAim()
    if not hookmetamethod then return end
    local oldIndex
    oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
        if isAlive and cfg.on.silentAim and not checkcaller() then
            if self == Mouse then
                local plr  = getClosestPlayerToCursor(cfg.saFov)
                local part = plr and getAimTargetPart(plr)
                if part then
                    if key == "Hit"    then return part.CFrame end
                    if key == "Target" then return part end
                    if key == "X"      then return select(1, screenPosition(part.Position)).X end
                    if key == "Y"      then return select(1, screenPosition(part.Position)).Y end
                end
            end
        end
        return oldIndex(self, key)
    end))

    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local args   = {...}
        local method = getnamecallmethod()
        if isAlive and cfg.on.silentAim and not checkcaller() then
            if method == "FireServer" then
                local remoteName = typeof(self) == "Instance" and self.Name or ""
                if remoteName == "ShootEvent" or remoteName == "shoot" or remoteName == "Shoot" then
                    local plr  = getClosestPlayerToCursor(cfg.saFov)
                    local part = plr and getAimTargetPart(plr)
                    if part then
                        if type(args[1]) == "table" then
                            for _, bullet in ipairs(args[1]) do
                                if type(bullet) == "table" then
                                    bullet.Hit      = part
                                    bullet.Cframe   = part.CFrame
                                    bullet.Distance = (Camera.CFrame.Position - part.Position).Magnitude
                                end
                            end
                        elseif typeof(args[1]) == "Vector3" then
                            args[1] = part.Position
                        elseif typeof(args[1]) == "CFrame" then
                            args[1] = part.CFrame
                        end
                    end
                end
            end
        end
        return oldNamecall(self, table.unpack(args))
    end))
end
pcall(installSilentAim)

local function executeTriggerBot()
    local char = getCharacter(LocalPlayer)
    if not char then return end
    local tool = char:FindFirstChildWhichIsA("Tool")
    if not tool then return end
    local ray  = Mouse.UnitRay
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {char}
    params.FilterType = Enum.RaycastFilterType.Exclude
    local hit = Workspace:Raycast(ray.Origin, ray.Direction * 500, params)
    if not hit or not hit.Instance then return end
    local model = hit.Instance:FindFirstAncestorOfClass("Model")
    if not model then return end
    local plr = Players:GetPlayerFromCharacter(model)
    if not plr or plr == LocalPlayer then return end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    pcall(function() tool:Activate() end)
    local remote = tool:FindFirstChildWhichIsA("RemoteEvent")
    if remote then
        pcall(function()
            remote:FireServer(hit.Position, ray.Direction, tool)
        end)
    end
end

local function executeKill(target)
    if not target or target == LocalPlayer then return end
    task.spawn(function()
        fetchItemGiver("Remington 870")
        task.wait(0.12)
        local gun = fetchAnyGun()
        if not gun then return end
        if ReplicatedStorage:FindFirstChild("ReloadEvent") then
            pcall(function() ReplicatedStorage.ReloadEvent:FireServer(gun) end)
        end
        local head = target.Character and target.Character:FindFirstChild("Head")
        if not head then return end
        local bullets = {}
        for i = 1, 15 do
            bullets[i] = {
                Hit       = head,
                Cframe    = head.CFrame,
                RayObject = Ray.new(Camera.CFrame.Position, (head.Position - Camera.CFrame.Position).Unit),
                Distance  = (Camera.CFrame.Position - head.Position).Magnitude,
            }
        end
        if ReplicatedStorage:FindFirstChild("ShootEvent") then
            pcall(function() ReplicatedStorage.ShootEvent:FireServer(bullets, gun) end)
        end
    end)
end

local function executeBring(target)
    if not target or target == LocalPlayer or not target.Character then return end
    local myRoot = getRoot(LocalPlayer)
    local targetRoot = getRoot(target)
    if not myRoot or not targetRoot then return end
    pcall(function()
        if getgenv and getgenv().setsimulationradius then
            getgenv().setsimulationradius(math.huge)
        end
    end)
    targetRoot.CFrame = myRoot.CFrame * CFrame.new(1.5, 0, -3)
end

local function isGroundTool(item)
    if not item:IsA("Tool") or not item:FindFirstChild("Handle") then return false end
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character and item:IsDescendantOf(p.Character) then return false end
        local bp = p:FindFirstChild("Backpack")
        if bp and item:IsDescendantOf(bp) then return false end
    end
    return item:IsDescendantOf(Workspace)
end

