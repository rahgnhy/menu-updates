local function setFeatureEnabled(featureId, state)
    cfg.on[featureId] = state
    saveConfig()

    local row = rowsUI[featureId]
    if row then
        TweenService:Create(row, TweenInfo.new(0.2), {
            BackgroundColor3 = state and TOGGLE_ON_BG or BG_SECONDARY
        }):Play()
        local bar = row:FindFirstChild("AccentBar")
        if bar then
            TweenService:Create(bar, TweenInfo.new(0.2), {
                BackgroundColor3 = state and ACCENT_COLOR or Color3.fromRGB(45, 52, 65)
            }):Play()
        end
        local title = row:FindFirstChild("TitleLabel")
        if title then
            TweenService:Create(title, TweenInfo.new(0.15), {
                TextColor3 = state and WHITE or TEXT_MAIN
            }):Play()
        end
    end

    if featureId == "fullbright" then
        if state then
            Lighting.Ambient       = Color3.fromRGB(180, 180, 180)
            Lighting.Brightness    = 0.8
            Lighting.GlobalShadows = false
        else
            Lighting.Ambient       = Color3.fromRGB(120, 120, 120)
            Lighting.Brightness    = 1
            Lighting.GlobalShadows = true
        end
    elseif featureId == "fly" and not state then
        local hum = getHumanoid(LocalPlayer)
        if hum then hum.PlatformStand = false end
    elseif featureId == "autoLock" and not state then
        lockedTarget = nil
    elseif featureId == "speedHack" and not state then
        local hum = getHumanoid(LocalPlayer)
        if hum then hum.WalkSpeed = 16 end
    elseif featureId == "infJump" and not state then
        local hum = getHumanoid(LocalPlayer)
        if hum then
            hum.UseJumpPower = true
            hum.JumpPower    = 50
        end
    elseif featureId == "noclip" and not state then
        local char = getCharacter(LocalPlayer)
        if char then
            for _, bp in ipairs(char:GetDescendants()) do
                if bp:IsA("BasePart") then bp.CanCollide = true end
            end
        end
    end
end

