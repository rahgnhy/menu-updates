local function animFlash(btn,col)
    if not cfg.clickAnim then return end
    local orig=btn.BackgroundColor3
    TweenSvc:Create(btn,TweenInfo.new(0.06),{BackgroundColor3=col or A}):Play()
    task.delay(0.12,function()
        TweenSvc:Create(btn,TweenInfo.new(0.15),{BackgroundColor3=orig}):Play()
    end)
end

local function animGlow(btn)
    if not cfg.clickAnim then return end
    local s=Instance.new("UIStroke",btn)
    s.Color=A s.Thickness=2
    TweenSvc:Create(s,TweenInfo.new(0.3),{Thickness=0}):Play()
    Debris:AddItem(s,0.35)
end

