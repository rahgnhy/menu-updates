    pcall(function()
        if Workspace:FindFirstChild("Remote") then
            if Workspace.Remote:FindFirstChild("arrest") then
                Workspace.Remote.arrest:FireServer(head)
            end
            if Workspace.Remote:FindFirstChild("Arrest") then
