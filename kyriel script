local function loadCfg()
    if isfile and readfile and isfile(CFG_FILE) then
        local ok, d = pcall(function()
            return Http:JSONDecode(readfile(CFG_FILE))
        end)
        if ok and type(d) == "table" then
            for k, v in pairs(d) do
                cfg[k] = v
            end
        end
    end
    if type(cfg.on) ~= "table" then
        cfg.on = {}
    end
    for _, k in ipairs(TOGGLES) do
        if cfg.on[k] == nil then
            cfg.on[k] = false
        end
    end
end

local function saveCfg()
    if writefile then
        pcall(function()
            writefile(CFG_FILE, Http:JSONEncode(cfg))
        end)
    end
end

