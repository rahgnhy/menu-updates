local function findPlr(str)
    str = str:lower()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower():find(str, 1, true) then return p end
        if p.DisplayName:lower():find(str, 1, true) then return p end
    end
    return nil
end

local function setSelected(p)
    selPlr          = p
    selLabel.Text   = p and ("Selected: " .. p.Name) or "Selected: none"
end

local function refreshList(filter)
    for _, c in ipairs(listF:GetChildren()) do
        if c:IsA("TextButton") then c:Destroy() end
    end
    filter   = (filter or ""):lower()
    local n  = 0
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp then
            local show = filter == ""
                or p.Name:lower():find(filter, 1, true)
                or p.DisplayName:lower():find(filter, 1, true)
            if show then
                n = n + 1
                local b = Instance.new("TextButton")
                b.Size             = UDim2.new(1, -4, 0, 24)
                b.BackgroundColor3 = selPlr == p and ON or Color3.fromRGB(16, 18, 22)
                b.BorderSizePixel  = 0
                b.Text             = "  " .. p.Name
                b.Font             = Enum.Font.Gotham
                b.TextSize         = 12
                b.TextColor3       = W
                b.TextXAlignment   = Enum.TextXAlignment.Left
                b.AutoButtonColor  = false
                b.Parent           = listF
                corner(b, 4)
                b.MouseButton1Click:Connect(function()
                    playSound(SND.click)
                    setSelected(p)
                    refreshList(tbox.Text)
                end)
                addHover(b, ROW2, selPlr == p and ON or Color3.fromRGB(16, 18, 22))
            end
        end
    end
    listF.CanvasSize = UDim2.new(0, 0, 0, n * 26 + 4)
end

