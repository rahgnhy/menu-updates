local function playClickAnimation(frame, color)
    if not cfg.clickAnim or not frame then return end
    if cfg.animStyle == "ripple" then
        local rip = Instance.new("Frame")
        rip.AnchorPoint          = Vector2.new(0.5, 0.5)
        rip.Position             = UDim2.new(0.5, 0, 0.5, 0)
        rip.Size                 = UDim2.new(0, 0, 0, 0)
        rip.BackgroundColor3     = color or WHITE
        rip.BackgroundTransparency = 0.6
        rip.BorderSizePixel      = 0
        rip.ZIndex               = frame.ZIndex + 4
        rip.Parent               = frame
        roundCorners(rip, 6)
        TweenService:Create(rip, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Size = UDim2.new(1.8, 0, 2.2, 0),
            BackgroundTransparency = 1,
        }):Play()
        Debris:AddItem(rip, 0.4)
    elseif cfg.animStyle == "flash" then
        local orig = frame.BackgroundColor3
        TweenService:Create(frame, TweenInfo.new(0.06), {BackgroundColor3 = color or ACCENT_COLOR}):Play()
        task.delay(0.12, function()
            TweenService:Create(frame, TweenInfo.new(0.15), {BackgroundColor3 = orig}):Play()
        end)
    elseif cfg.animStyle == "glow" then
        local s = Instance.new("UIStroke", frame)
        s.Color     = ACCENT_COLOR
        s.Thickness = 2.5
        TweenService:Create(s, TweenInfo.new(0.3), {Thickness = 0}):Play()
        Debris:AddItem(s, 0.35)
    end
end

