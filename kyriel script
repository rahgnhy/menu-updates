local function mkLine(thick, col)
    local l = Drawing.new("Line")
    l.Visible   = false
    l.Thickness = thick or 1.5
    l.Color     = col or A
    table.insert(draws, l)
    return l
end

local function mkSquare(thick, col)
    local s = Drawing.new("Square")
    s.Filled    = false
    s.Thickness = thick or 1.5
    s.Color     = col or A
    s.Visible   = false
    table.insert(draws, s)
    return s
end

local function mkText(size)
    local t = Drawing.new("Text")
    t.Size    = size or 13
    t.Center  = true
    t.Outline = true
    t.Color   = A
    t.Visible = false
    t.Font    = 2
    table.insert(draws, t)
    return t
end

local function getEspColor(p)
    if cfg.espRainbow then
        return Color3.fromHSV(rainbowH, 0.85, 1)
    end
    if cfg.espTeamColor then
        local tn = getTeamName(p)
        return TEAM_COLORS[tn] or TEAM_COLORS.default
    end
    return A
end

local function setupEsp(p)
    if p == lp or esp[p] then return end
    pcall(function()
        if not Drawing then return end
        local corners = {}
        for i = 1, 8 do
            corners[i] = mkLine(1.8)
        end
        local box     = mkSquare(1.5)
        local outline = mkSquare(3)
        outline.Color = Color3.new(0, 0, 0)

        local hBG  = Drawing.new("Square")
        hBG.Filled    = true
        hBG.Color     = Color3.fromRGB(20, 20, 20)
        hBG.Visible   = false
        hBG.Thickness = 1
        table.insert(draws, hBG)

        local hBar = Drawing.new("Square")
        hBar.Filled    = true
        hBar.Color     = Color3.fromRGB(0, 200, 80)
        hBar.Visible   = false
        hBar.Thickness = 1
        table.insert(draws, hBar)

        local snapLine = mkLine(1, Color3.fromRGB(29, 186, 138))

        esp[p]  = {box=box, outline=outline, corners=corners, hBG=hBG, hBar=hBar, snap=snapLine}
        tags[p] = mkText(13)
    end)
end

for _, p in ipairs(Players:GetPlayers()) do setupEsp(p) end
bind(Players.PlayerAdded:Connect(setupEsp))
bind(Players.PlayerRemoving:Connect(function(p)
    if esp[p] then
        pcall(function()
            esp[p].box:Remove()
            esp[p].outline:Remove()
            esp[p].snap:Remove()
            esp[p].hBG:Remove()
            esp[p].hBar:Remove()
            for _, l in ipairs(esp[p].corners) do
                l:Remove()
            end
        end)
        esp[p] = nil
    end
    if tags[p] then
        pcall(function() tags[p]:Remove() end)
        tags[p] = nil
    end
    if selPlr  == p then selPlr  = nil end
    if locked  == p then locked  = nil end
end))

