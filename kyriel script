local WEAPON_PRIORITY = {"remington", "shotgun", "ak-47", "ak", "m4a1", "m4", "m9", "glock", "pistol"}
local function organizeHotbar()
    if hotbarActive then return end
    hotbarActive = true
    task.defer(function()
        local bp = LocalPlayer:FindFirstChild("Backpack")
        if bp then
            local tools = {}
            for _, item in ipairs(bp:GetChildren()) do
                if item:IsA("Tool") then table.insert(tools, item) end
            end
            table.sort(tools, function(a, b)
                local scoreA, scoreB = 99, 99
                for index, key in ipairs(WEAPON_PRIORITY) do
                    if a.Name:lower():find(key) then scoreA = math.min(scoreA, index) end
                    if b.Name:lower():find(key) then scoreB = math.min(scoreB, index) end
                end
                return scoreA < scoreB
            end)
            for _, t in ipairs(tools) do t.Parent = nil end
            for _, t in ipairs(tools) do t.Parent = bp end
        end
        task.wait(0.8)
        hotbarActive = false
    end)
end

