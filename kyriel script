local function updateChams(player)
    if player == LocalPlayer then return end
    local function applyToChar(char)
        local existing = char:FindFirstChild("_KyChamsHighlight")
        if existing then existing:Destroy() end
        if not cfg.on.chams then return end
        local hl = Instance.new("Highlight")
        hl.Name             = "_KyChamsHighlight"
        hl.FillColor        = TEAM_COLORS[getPlayerTeam(player)] or ACCENT_COLOR
        hl.OutlineColor     = WHITE
        hl.FillTransparency = 0.5
        hl.Parent           = char
    end
    if player.Character then applyToChar(player.Character) end
    trackConnection(player.CharacterAdded:Connect(applyToChar))
end

for _, p in ipairs(Players:GetPlayers()) do updateChams(p) end
