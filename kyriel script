bind(RunService.Stepped:Connect(function()
    if not alive then return end
    local c = ch()

    if cfg.on.noclip and c then
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") then
                p.CanCollide = false
            end
        end
        -- Keep stepping (humanoid handles floor via state machine)
    end

    if cfg.on.antiFall then
        local h2 = hum()
        if h2 then
            h2:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            h2:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        end
    end

    if c then
        for _, v in ipairs(c:GetDescendants()) do
            local n = v.Name:lower()
            if cfg.on.antiRiotShield and (n:find("shield") or n:find("riot")) then
                pcall(function() v:Destroy() end)
            end
            if cfg.on.antiTaze and (n:find("taze") or n:find("stun")) then
                pcall(function() v:Destroy() end)
            end
            if cfg.on.antiCuff and (n:find("cuff") or n == "handcuffs") then
                pcall(function() v:Destroy() end)
            end
        end
        if cfg.on.antiTaze then
            local h2 = hum()
            if h2 and cfg.on.speedHack and h2.WalkSpeed < _targetSpeed * 0.8 then
                h2.WalkSpeed = _targetSpeed
            end
        end
    end

    if cfg.on.fenceGod then
        local h2 = hum()
        if h2 and h2.Health < h2.MaxHealth then
            h2.Health = h2.MaxHealth
        end
    end

    if cfg.on.autoArrest then
        local r2 = root()
        if r2 and isGuard(lp) then
            for _, p in ipairs(Players:GetPlayers()) do
                if isArrestable(p) and p.Character then
                    local pr = p.Character:FindFirstChild("HumanoidRootPart")
                    if pr and (r2.Position - pr.Position).Magnitude <= cfg.arrestRange then
                        if equipCuffs() then
                            task.delay(0.1, function() arrestPlayer(p) end)
                        end
                    end
                end
            end
        end
    end

    if cfg.on.autoTaser then
        local r2 = root()
        if r2 then
            local c2    = ch()
            local taser = nil
            if c2 then taser = c2:FindFirstChild("Taser") end
            if not taser then
                local bp = lp:FindFirstChild("Backpack")
                if bp then taser = bp:FindFirstChild("Taser") end
            end
            if taser and c2 then
                if taser.Parent ~= c2 then taser.Parent = c2 end
                for _, p in ipairs(Players:GetPlayers()) do
                    if isArrestable(p) and p.Character then
                        local pr = p.Character:FindFirstChild("HumanoidRootPart")
                        if pr and (r2.Position - pr.Position).Magnitude < 40 then
                            pcall(function() taser:Activate() end)
                            local re = taser:FindFirstChildWhichIsA("RemoteEvent")
                            if re then
                                pcall(function() re:FireServer(pr.Position) end)
                            end
                        end
                    end
                end
            end
        end
    end

    if cfg.on.gunMods then
        local now  = os.clock()
        local c2   = ch()
        local tool = nil
        if c2 then tool = c2:FindFirstChildWhichIsA("Tool") end

        if tool and now - lastGunT > 0.3 then
            lastGunT = now
            pcall(function()
                local gs = tool:FindFirstChild("GunStates")
                if gs then
                    local mod = require(gs)
                    if type(mod) == "table" then
                        if cfg.noSpread then
                            mod.Spread      = 0
                            mod.MaxSpread   = 0
                            mod.MinSpread   = 0
                            mod.RecoilSpread= 0
                            mod.AimSpread   = 0
                        end
                        if cfg.fullAuto then
                            mod.AutoFire      = true
                            mod.Automatic     = true
                            mod.SemiAutomatic = false
                        end
                        if cfg.infAmmo then
                            mod.CurrentAmmo = 999
                            mod.MaxAmmo     = 999
                            mod.StoredAmmo  = 999
                        end
                    end
                end
                for _, v in ipairs(tool:GetDescendants()) do
                    if v:IsA("NumberValue") or v:IsA("IntValue") then
                        local n = v.Name:lower()
                        if cfg.infAmmo and (n:find("ammo") or n:find("clip") or n:find("mag")) then
                            v.Value = 999
                        end
                        if cfg.noSpread and (n:find("spread") or n:find("bloom")) then
                            v.Value = 0
                        end
                    end
                    if v:IsA("BoolValue") then
                        local n = v.Name:lower()
                        if cfg.fullAuto and (n:find("semi") or n:find("burst")) then
                            v.Value = false
                        end
                        if cfg.fullAuto and n:find("auto") then
                            v.Value = true
                        end
                    end
                end
            end)
        end

        if tool and cfg.fullAuto and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
            for _ = 1, math.clamp(cfg.fireRate, 1, 6) do
                pcall(function() tool:Activate() end)
            end
        end
    end

    if cfg.on.autoPickup and os.clock() - lastPickup > 0.3 then
        lastPickup = os.clock()
        local r2 = root()
        if r2 then
            local best = nil
            local bd   = nil
            for _, v in ipairs(workspace:GetDescendants()) do
                if isLooseTool(v) then
                    local d = (r2.Position - v.Handle.Position).Magnitude
                    if d <= cfg.pickupRange and (bd == nil or d < bd) then
                        best = v
                        bd   = d
                    end
                end
            end
            if best then
                safeCall(function() best.Parent = lp.Backpack end)
            end
        end
    end
end))

