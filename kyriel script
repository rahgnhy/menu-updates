-- ══ LOOSE TOOL ══
local function isLooseTool(t)
    if not t:IsA("Tool") or not t:FindFirstChild("Handle") then return false end
    for _,p in ipairs(Players:GetPlayers()) do
        if p.Character and t:IsDescendantOf(p.Character) then return false end
        local bp=p:FindFirstChild("Backpack")
        if bp and t:IsDescendantOf(bp) then return false end
    end
    return t:IsDescendantOf(workspace)
end

-- ══ GUN MODS (VapeV4 GunStates method) ══
-- Directly patches the required GunStates module table
local function applyGunMods(tool)
    if not tool then return end
    -- Method 1: GunStates require
    pcall(function()
        local gs=tool:FindFirstChild("GunStates")
        if gs then
            local ok,mod=pcall(require,gs)
            if ok and type(mod)=="table" then
                if cfg.infAmmo   then mod.CurrentAmmo=999 mod.MaxAmmo=999 mod.StoredAmmo=999 end
                if cfg.noSpread  then mod.Spread=0 mod.MaxSpread=0 mod.MinSpread=0 mod.RecoilSpread=0 mod.AimSpread=0 end
                if cfg.fullAuto  then mod.AutoFire=true mod.Automatic=true mod.SemiAutomatic=false mod.FireMode="Automatic" end
            end
        end
    end)
    -- Method 2: Raw value patching
    for _,v in ipairs(tool:GetDescendants()) do
        if v:IsA("NumberValue") or v:IsA("IntValue") then
            local n=v.Name:lower()
            if cfg.infAmmo  and (n:find("ammo") or n:find("clip") or n:find("mag") or n:find("bullet")) then v.Value=999 end
            if cfg.noSpread and (n:find("spread") or n:find("bloom") or n:find("recoil")) then v.Value=0 end
        end
        if v:IsA("BoolValue") then
            local n=v.Name:lower()
            if cfg.fullAuto then
                if n:find("semi") or n:find("burst") then v.Value=false end
                if n:find("auto") or n:find("full")  then v.Value=true  end
            end
        end
        if v:IsA("StringValue") then
            local n=v.Name:lower()
            if cfg.fullAuto and (n:find("mode") or n:find("fire")) then v.Value="Automatic" end
        end
    end
end

-- ══ AUTO RELOAD (correct method — fire ReloadEvent when ammo low) ══
local lastReload=0
local function checkAutoReload()
    if not cfg.on.autoReload then return end
    if os.clock()-lastReload<1.5 then return end
    local c=ch() if not c then return end
    local tool=c:FindFirstChildWhichIsA("Tool") if not tool then return end
    for _,v in ipairs(tool:GetDescendants()) do
        if (v:IsA("NumberValue") or v:IsA("IntValue")) then
            local n=v.Name:lower()
            if (n:find("ammo") or n:find("clip")) and v.Value<=0 then
                lastReload=os.clock()
                pcall(function() RS.ReloadEvent:FireServer(tool) end)
                pcall(function()
                    local re=tool:FindFirstChild("ReloadEvent")
                    if re and re:IsA("RemoteEvent") then re:FireServer() end
                end)
                break
            end
        end
    end
end

-- ══ AUTO PICKUP (workspace scan, skips player-owned) ══
local function doAutoPickup()
    local r=root() if not r then return end
    local best,bd=nil,cfg.pickupRange
    for _,v in ipairs(workspace:GetDescendants()) do
        if isLooseTool(v) then
            local d=(r.Position-v.Handle.Position).Magnitude
            if d<bd then best=v bd=d end
        end
    end
    if best then
        pcall(function()
            -- Method 1: direct parent
            best.Parent=lp.Backpack
        end)
        -- Method 2: ItemHandler
        pcall(function()
            workspace.Remote.ItemHandler:InvokeServer(best)
        end)
    end
end

-- ══ NOCLIP (wall-only: preserves Y/floor collision via Humanoid stepping) ══
local function updateNoclip()
    local c=ch() if not c then return end
    for _,p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") then
            -- Keep HumanoidRootPart CanCollide OFF for walls
            -- Humanoid's stepping system handles floor automatically via state
            p.CanCollide=false
        end
    end
    -- Force humanoid to stay in running state so it doesn't fall endlessly
    local h2=hum()
    if h2 then
        local state=h2:GetState()
        if state==Enum.HumanoidStateType.Freefall then
            h2:ChangeState(Enum.HumanoidStateType.Running)
        end
    end
end

-- ══ ESP DRAWINGS ══
local esp={} local tags={}

local function mkDraw(t2,props)
    local d=Drawing.new(t2)
    for k,v in pairs(props) do d[k]=v end
    d.Visible=false table.insert(draws,d) return d
end

local function mkLine(col)
    return mkDraw("Line",{Thickness=1.8,Color=col or A})
end

local function setupEsp(p)
    if p==lp or esp[p] then return end
    pcall(function()
        if not Drawing then return end
        local corners={}
        for i=1,8 do corners[i]=mkLine(A) end
        local box=mkDraw("Square",{Filled=false,Thickness=1.5,Color=A})
        local outline=mkDraw("Square",{Filled=false,Thickness=3,Color=Color3.new(0,0,0)})
        local hBG=mkDraw("Square",{Filled=true,Color=Color3.fromRGB(20,20,20),Thickness=1})
        local hBar=mkDraw("Square",{Filled=true,Color=Color3.fromRGB(0,200,80),Thickness=1})
        local tag=mkDraw("Text",{Size=13,Center=true,Outline=true,Color=A,Font=2})
        esp[p]={box=box,outline=outline,corners=corners,hBG=hBG,hBar=hBar}
        tags[p]=tag
    end)
end
for _,p in ipairs(Players:GetPlayers()) do setupEsp(p) end
bind(Players.PlayerAdded:Connect(setupEsp))
bind(Players.PlayerRemoving:Connect(function(p)
    if esp[p] then
        pcall(function()
            esp[p].box:Remove() esp[p].outline:Remove()
            esp[p].hBG:Remove() esp[p].hBar:Remove()
            for _,l in ipairs(esp[p].corners) do l:Remove() end
        end) esp[p]=nil
    end
    if tags[p] then pcall(function() tags[p]:Remove() end) tags[p]=nil end
    if selPlr==p then selPlr=nil end
    if locked==p then locked=nil end
end))

