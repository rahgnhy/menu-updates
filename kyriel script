trackConnection(RunService.RenderStepped:Connect(function()
    if not isAlive then return end
    Camera       = Workspace.CurrentCamera
    espPulseTick = espPulseTick + 0.05
    rainbowHue   = (rainbowHue + 0.003) % 1

    if fovCircleDrawing then
        local show = cfg.on.silentAim and cfg.saCircle
        fovCircleDrawing.Visible = show
        if show then
            fovCircleDrawing.Position = Vector2.new(Mouse.X, Mouse.Y)
            fovCircleDrawing.Radius   = cfg.saFov
            fovCircleDrawing.Color    = ACCENT_COLOR
        end
    end

    if cfg.on.autoLock and lockedTarget then
        local part = getAimTargetPart(lockedTarget)
        local hum  = getHumanoid(lockedTarget)
        if not part or not hum or hum.Health <= 0 then
            lockedTarget = nil
        else
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, part.Position)
        end
    end

    if cfg.on.triggerBot then
        local now = os.clock()
        if now - lastTriggerTick >= 0.05 then
            lastTriggerTick = now
            executeTriggerBot()
        end
    end

    for _, p in ipairs(Players:GetPlayers()) do
        local espObj = espData[p]
        local tagObj = espTags[p]
        local rootPart = getRoot(p)
        local hum = getHumanoid(p)

        local color = ACCENT_COLOR
        if cfg.espRainbow then
            color = Color3.fromHSV(rainbowHue, 0.85, 1)
        elseif cfg.espTeamColor then
            color = TEAM_COLORS[getPlayerTeam(p)] or TEAM_COLORS.default
        end

        if espObj then
            local active = cfg.on.esp and rootPart ~= nil and hum ~= nil and hum.Health > 0
            if active then
                local topPos, onScreen = screenPosition(rootPart.Position + Vector3.new(0, 3.2, 0))
                local botPos = select(1, screenPosition(rootPart.Position - Vector3.new(0, 3.0, 0)))
                if onScreen then
                    local height = math.abs(topPos.Y - botPos.Y)
                    local width  = height * 0.55
                    local cx, cy = topPos.X, topPos.Y
                    local pct    = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                    local pulse  = cfg.espPulse and (1 + math.sin(espPulseTick) * 0.04) or 1
                    local pw, ph = width * pulse, height * pulse

                    if cfg.espStyle == "box" then
                        espObj.outline.Size     = Vector2.new(pw + 3, ph + 3)
                        espObj.outline.Position = Vector2.new(cx - (pw + 3) / 2, cy - 1)
                        espObj.outline.Visible  = true
                        espObj.box.Size         = Vector2.new(pw, ph)
                        espObj.box.Position     = Vector2.new(cx - pw / 2, cy)
                        espObj.box.Color        = color
                        espObj.box.Visible      = true
                        for _, l in ipairs(espObj.corners) do l.Visible = false end
                    else
                        espObj.box.Visible     = false
                        espObj.outline.Visible = false
                        local cornerLen = pw * 0.28
                        local x1, x2    = cx - pw / 2, cx + pw / 2
                        local y1, y2    = cy, cy + ph
                        local function assignLine(line, fx, fy, tx, ty)
                            line.From    = Vector2.new(fx, fy)
                            line.To      = Vector2.new(tx, ty)
                            line.Color   = color
                            line.Visible = true
                        end
                        assignLine(espObj.corners[1], x1, y1, x1 + cornerLen, y1)
                        assignLine(espObj.corners[2], x1, y1, x1, y1 + cornerLen)
                        assignLine(espObj.corners[3], x2, y1, x2 - cornerLen, y1)
                        assignLine(espObj.corners[4], x2, y1, x2, y1 + cornerLen)
                        assignLine(espObj.corners[5], x1, y2, x1 + cornerLen, y2)
                        assignLine(espObj.corners[6], x1, y2, x1, y2 - cornerLen)
                        assignLine(espObj.corners[7], x2, y2, x2 - cornerLen, y2)
                        assignLine(espObj.corners[8], x2, y2, x2, y2 - cornerLen)
                    end

                    local bx    = cx - pw / 2 - 6
                    local barH  = ph * pct
                    espObj.hBG.Size      = Vector2.new(3, ph)
                    espObj.hBG.Position  = Vector2.new(bx, cy)
                    espObj.hBG.Visible   = true
                    espObj.hBar.Size     = Vector2.new(3, barH)
                    espObj.hBar.Position = Vector2.new(bx, cy + ph - barH)
                    espObj.hBar.Color    = Color3.fromRGB(math.floor((1 - pct) * 255), math.floor(pct * 220), 40)
                    espObj.hBar.Visible  = true
                else
                    espObj.box.Visible     = false
                    espObj.outline.Visible = false
                    espObj.hBG.Visible     = false
                    espObj.hBar.Visible    = false
                    for _, l in ipairs(espObj.corners) do l.Visible = false end
                end
            else
                espObj.box.Visible     = false
                espObj.outline.Visible = false
                espObj.hBG.Visible     = false
                espObj.hBar.Visible    = false
                for _, l in ipairs(espObj.corners) do l.Visible = false end
            end
        end

        if tagObj then
            if cfg.on.nameTags and rootPart and hum and hum.Health > 0 then
                local topPos, onScreen = screenPosition(rootPart.Position + Vector3.new(0, 3.8, 0))
                if onScreen then
                    if cfg.tagStyle == "minimal" then
                        tagObj.Text = p.Name
                    elseif cfg.tagStyle == "full" then
                        local dist = math.floor((Camera.CFrame.Position - rootPart.Position).Magnitude)
                        tagObj.Text = string.format("%s | %d HP | %dm", p.Name, math.floor(hum.Health), dist)
                    else
                        tagObj.Text = string.format("%s [%d]", p.Name, math.floor(hum.Health))
                    end
                    tagObj.Position = topPos
                    tagObj.Color    = color
                    tagObj.Visible  = true
                else
                    tagObj.Visible = false
                end
            else
                tagObj.Visible = false
            end
        end
    end
end))

trackConnection(RunService.Heartbeat:Connect(function(deltaTime)
    if not isAlive then return end
    local hum      = getHumanoid(LocalPlayer)
    local rootPart = getRoot(LocalPlayer)

    if cfg.on.fly and rootPart then
        local velocity = Vector3.zero
        local cframe   = Camera.CFrame
        if UserInputService:IsKeyDown(Enum.KeyCode.W)           then velocity = velocity + cframe.LookVector  end
        if UserInputService:IsKeyDown(Enum.KeyCode.S)           then velocity = velocity - cframe.LookVector  end
        if UserInputService:IsKeyDown(Enum.KeyCode.A)           then velocity = velocity - cframe.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D)           then velocity = velocity + cframe.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space)       then velocity = velocity + Vector3.yAxis  end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then velocity = velocity - Vector3.yAxis  end
        if velocity.Magnitude > 0 then
            rootPart.CFrame = rootPart.CFrame + velocity.Unit * cfg.flySpeed * deltaTime
        end
        rootPart.AssemblyLinearVelocity  = Vector3.zero
        rootPart.AssemblyAngularVelocity = Vector3.zero
        if hum then hum.PlatformStand = true end
    end

    if cfg.on.godMode and hum then
        pcall(function()
            hum.BreakJointsOnDeath = false
            if hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
        end)
    end

    if cfg.on.speedHack and hum then
