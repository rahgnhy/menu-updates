local function getGun()
    local function scan(folder)
        if not folder then return nil end
        for _, t in ipairs(folder:GetChildren()) do
            if t:IsA("Tool") and t:FindFirstChild("GunStates") then
                return t
            end
        end
        return nil
    end
    local c = ch()
    if c then
        local g = scan(c)
        if g then return g end
    end
    local bp = lp:FindFirstChild("Backpack")
    if bp then
        return scan(bp)
    end
    return nil
end

local function scr(v3)
    local v, on = cam:WorldToViewportPoint(v3)
    return Vector2.new(v.X, v.Y), on and v.Z > 0
end

local function center()
    local s = cam.ViewportSize
    return Vector2.new(s.X / 2, s.Y / 2)
end

local function aimPart(p)
    local c = p.Character
    if not c then return nil end
    if cfg.saHead then
        local head = c:FindFirstChild("Head")
        if head then return head end
    end
    return c:FindFirstChild("HumanoidRootPart")
end

local function visCheck(part)
    if not cfg.saVis then return true end
    local origin = cam.CFrame.Position
    local pr = RaycastParams.new()
    pr.FilterDescendantsInstances = {ch()}
    pr.FilterType = Enum.RaycastFilterType.Exclude
    local hit = workspace:Raycast(origin, part.Position - origin, pr)
    if not hit then return true end
    if hit.Instance then
        return hit.Instance:IsDescendantOf(part.Parent.Parent or part.Parent)
    end
    return false
end

local function closestToCursor(maxFov)
    local mPos = Vector2.new(mouse.X, mouse.Y)
    local best     = nil
    local bestDist = maxFov
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp then
            local part = aimPart(p)
            local h2   = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
            if part and h2 and h2.Health > 0 then
                local sp, on = scr(part.Position)
                if on then
                    local dist = (sp - mPos).Magnitude
                    if dist < bestDist and visCheck(part) then
                        bestDist = dist
                        best     = p
                    end
                end
            end
        end
    end
    return best, bestDist
end

-- ══ SILENT AIM ══
local function installSilentAim()
    if not hookmetamethod then return end
    local wrap = newcclosure or function(f) return f end
    local chk  = checkcaller or function() return false end

    local oldIndex
    oldIndex = hookmetamethod(game, "__index", wrap(function(self, k)
        if alive and cfg.on.silentAim and not chk() then
            if self == mouse then
                local plr  = closestToCursor(cfg.saFov)
                local part = plr and aimPart(plr)
                if part then
                    if k == "Hit"    then return part.CFrame end
                    if k == "Target" then return part end
                    if k == "X"      then
                        local sp = select(1, scr(part.Position))
                        return sp.X
                    end
                    if k == "Y"      then
                        local sp = select(1, scr(part.Position))
                        return sp.Y
                    end
                end
            end
        end
        return oldIndex(self, k)
    end))

    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", wrap(function(self, ...)
        local args   = {...}
        local method = getnamecallmethod()
        if alive and cfg.on.silentAim and not chk() then
            if method == "FireServer" then
                local name = ""
                if typeof(self) == "Instance" then
                    name = self.Name
                end
                if name == "ShootEvent" or name == "shoot" or name == "Shoot" then
                    local plr  = closestToCursor(cfg.saFov)
                    local part = plr and aimPart(plr)
                    if part then
                        if type(args[1]) == "table" then
                            for _, ev in ipairs(args[1]) do
                                if type(ev) == "table" then
                                    ev.Hit      = part
                                    ev.Cframe   = part.CFrame
                                    ev.Distance = (cam.CFrame.Position - part.Position).Magnitude
                                end
                            end
                        elseif typeof(args[1]) == "Vector3" then
                            args[1] = part.Position
                        elseif typeof(args[1]) == "CFrame" then
                            args[1] = part.CFrame
                        end
                    end
                end
            end
        end
        return oldNamecall(self, table.unpack(args))
    end))
end
pcall(installSilentAim)

-- ══ TRIGGER BOT ══
local function checkTrigger()
    local tool = nil
    local c    = ch()
    if c then
        tool = c:FindFirstChildWhichIsA("Tool")
    end
    if not tool then return end
    local unit = mouse.UnitRay
    local pr   = RaycastParams.new()
    pr.FilterDescendantsInstances = {c}
    pr.FilterType = Enum.RaycastFilterType.Exclude
    local hit = workspace:Raycast(unit.Origin, unit.Direction * 500, pr)
    if not hit then return end
    local model = hit.Instance:FindFirstAncestorOfClass("Model")
    if not model then return end
    local pl = Players:GetPlayerFromCharacter(model)
    if not pl or pl == lp then return end
    local h2 = model:FindFirstChildOfClass("Humanoid")
    if not h2 or h2.Health <= 0 then return end
    pcall(function() tool:Activate() end)
    local remote = tool:FindFirstChildWhichIsA("RemoteEvent")
    if remote then
        pcall(function()
            remote:FireServer(hit.Position, unit.Direction, tool)
        end)
    end
end

-- ══ BRING PLAYER ══
local function bringPlayer(p)
    if not p or p == lp or not p.Character then return end
    local r2    = root()
    local tRoot = p.Character:FindFirstChild("HumanoidRootPart")
    if not r2 or not tRoot then return end
    pcall(function()
        if getgenv then
            local g = getgenv()
            if g.setsimulationradius   then g.setsimulationradius(math.huge) end
            if g.sethiddenproperty     then g.sethiddenproperty(lp, "MaxSimulationRadius", math.huge) end
        end
    end)
    pcall(function() tRoot:SetNetworkOwner(nil) end)
    tRoot.CFrame = r2.CFrame * CFrame.new(2, 0, -3)
    local startT = os.clock()
    task.spawn(function()
        while alive do
            if not p.Character then break end
            local t3 = p.Character:FindFirstChild("HumanoidRootPart")
            local r3 = root()
            if not t3 or not r3 then break end
            if os.clock() - startT > 15 then break end
            pcall(function()
                t3.CFrame = r3.CFrame * CFrame.new(2, 0, -3)
            end)
            task.wait(0.05)
        end
    end)
end

-- ══ KILL PLAYER ══
local function killPlayer(p)
    if not p or p == lp then return end
    task.spawn(function()
        giveShotgun()
        task.wait(0.2)
        local gun = getGun()
        if not gun then return end
        pcall(function() RS.ReloadEvent:FireServer(gun) end)
        if not p.Character then return end
        local head = p.Character:FindFirstChild("Head")
        if not head then return end
        local events = {}
        for i = 1, 12 do
            events[i] = {
                Hit       = head,
                Cframe    = head.CFrame,
                RayObject = Ray.new(cam.CFrame.Position, (head.Position - cam.CFrame.Position).Unit),
                Distance  = (cam.CFrame.Position - head.Position).Magnitude,
            }
        end
        pcall(function() RS.ShootEvent:FireServer(events, gun) end)
    end)
end

-- ══ LOOSE TOOL ══
local function isLooseTool(t)
    if not t:IsA("Tool") or not t:FindFirstChild("Handle") then return false end
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character and t:IsDescendantOf(p.Character) then return false end
        local bp = p:FindFirstChild("Backpack")
        if bp and t:IsDescendantOf(bp) then return false end
    end
    return t:IsDescendantOf(workspace)
end

