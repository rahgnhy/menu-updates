-- Animations
local function animRipple(frame, col)
    if not cfg.clickAnim then return end
    local r = Instance.new("Frame")
    r.AnchorPoint          = Vector2.new(0.5, 0.5)
    r.Position             = UDim2.new(0.5, 0, 0.5, 0)
    r.Size                 = UDim2.new(0, 0, 0, 0)
    r.BackgroundColor3     = col or W
    r.BackgroundTransparency = 0.65
    r.BorderSizePixel      = 0
    r.ZIndex               = frame.ZIndex + 5
    r.Parent               = frame
    corner(r, 4)
    TweenSvc:Create(r, TweenInfo.new(0.38, Enum.EasingStyle.Quart), {
        Size                 = UDim2.new(2, 0, 2, 0),
        BackgroundTransparency = 1,
    }):Play()
    Debris:AddItem(r, 0.42)
end

local function animFlash(frame, col)
    if not cfg.clickAnim then return end
    local orig = frame.BackgroundColor3
    TweenSvc:Create(frame, TweenInfo.new(0.05), {BackgroundColor3 = col or A}):Play()
    task.delay(0.12, function()
        TweenSvc:Create(frame, TweenInfo.new(0.18), {BackgroundColor3 = orig}):Play()
    end)
end

local function animGlow(frame)
    if not cfg.clickAnim then return end
    local s = Instance.new("UIStroke", frame)
    s.Color     = A
    s.Thickness = 2
    TweenSvc:Create(s, TweenInfo.new(0.35), {Thickness = 0}):Play()
    Debris:AddItem(s, 0.4)
end

local function doAnim(frame, col)
    if cfg.animStyle == "ripple"     then animRipple(frame, col)
    elseif cfg.animStyle == "flash"  then animFlash(frame, col)
    elseif cfg.animStyle == "glow"   then animGlow(frame) end
end

local function addHover(btn, hc, nc)
    hc = hc or ROW2
    nc = nc or ROW
    btn.MouseEnter:Connect(function()
        TweenSvc:Create(btn, TweenInfo.new(0.09), {BackgroundColor3 = hc}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenSvc:Create(btn, TweenInfo.new(0.11), {BackgroundColor3 = nc}):Play()
    end)
end

local function makeDraggable(handle, target)
    local dragging = false
    local startI   = nil
    local startP   = nil
    handle.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            startI   = i.Position
            startP   = target.Position
        end
    end)
    bind(UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end))
    bind(UIS.InputChanged:Connect(function(i)
        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
            local d = i.Position - startI
            target.Position = UDim2.new(
                startP.X.Scale, startP.X.Offset + d.X,
                startP.Y.Scale, startP.Y.Offset + d.Y
            )
        end
    end))
end

