        settPanel.Parent           = parent

        local sl = Instance.new("UIListLayout")
        sl.SortOrder = Enum.SortOrder.LayoutOrder
        sl.Parent    = settPanel
        buildSettings(settPanel)

        sl:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            if settPanel.Visible then
                settPanel.Size = UDim2.new(1, 0, 0, sl.AbsoluteContentSize.Y)
            end
        end)
    end

    local leftW = buildSettings and UDim2.new(1, -28, 1, 0) or UDim2.new(1, 0, 1, 0)
    local leftBtn = Instance.new("TextButton")
