local function createPlayerESP(player)
    if player == LocalPlayer or espData[player] then return end
    pcall(function()
        if not Drawing then return end
        local corners = {}
        for i = 1, 8 do
            corners[i] = createDrawing("Line", {Thickness = 1.5, Color = ACCENT_COLOR, Visible = false})
        end
        local box     = createDrawing("Square", {Thickness = 1.2, Color = ACCENT_COLOR, Filled = false, Visible = false})
        local outline = createDrawing("Square", {Thickness = 2.4, Color = Color3.new(0, 0, 0), Filled = false, Visible = false})
        local hBG     = createDrawing("Square", {Thickness = 1, Color = Color3.fromRGB(15, 15, 15), Filled = true, Visible = false})
        local hBar    = createDrawing("Square", {Thickness = 1, Color = Color3.fromRGB(0, 220, 80), Filled = true, Visible = false})

        espData[player] = {box = box, outline = outline, corners = corners, hBG = hBG, hBar = hBar}
        espTags[player] = createDrawing("Text", {Size = 13, Center = true, Outline = true, Color = ACCENT_COLOR, Visible = false, Font = 2})
    end)
end

local function removePlayerESP(player)
    if espData[player] then
        pcall(function()
            espData[player].box:Remove()
            espData[player].outline:Remove()
            espData[player].hBG:Remove()
            espData[player].hBar:Remove()
            for _, l in ipairs(espData[player].corners) do l:Remove() end
        end)
        espData[player] = nil
    end
    if espTags[player] then
        pcall(function() espTags[player]:Remove() end)
        espTags[player] = nil
    end
end

