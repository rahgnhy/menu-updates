local function isGuard(p)
    local t=p.Team if not t then return false end
    return t.TeamColor==BrickColor.new("Bright blue") or t.Name:lower():find("guard")
end
local function isArrestable(p)
    if p==lp or not p.Character then return false end
    local t=p.Team if not t then return false end
    if t.TeamColor==BrickColor.new("Bright blue") then return false end
    local n=t.Name:lower()
    return t.TeamColor==BrickColor.new("Bright orange") or t.TeamColor==BrickColor.new("Really red")
        or n:find("inmate") or n:find("criminal") or n:find("prisoner") or true
end

local function equipCuffs()
    local c,bp=ch(),lp:FindFirstChild("Backpack") if not c then return false end
    local function cuff(t) return t:IsA("Tool") and t.Name:lower():find("cuff") end
    if c:FindFirstChildWhichIsA("Tool") and cuff(c:FindFirstChildWhichIsA("Tool")) then return true end
    if bp then for _,t in ipairs(bp:GetChildren()) do if cuff(t) then t.Parent=c return true end end end
    return false
end

local function arrestPlr(p)
    if not p or not p.Character then return end
    local head=p.Character:FindFirstChild("Head") if not head then return end
    pcall(function() workspace.Remote.arrest:FireServer(head) end)
    pcall(function() workspace.Remote.Arrest:FireServer(head) end)
end

local function getGun()
    local function scan(f)
        for _,t in ipairs(f:GetChildren()) do
            if t:IsA("Tool") and t:FindFirstChild("GunStates") and t.Name~="Taser" then return t end
        end
    end
    local g=ch() and scan(ch()) if g then return g end
    if lp:FindFirstChild("Backpack") then return scan(lp.Backpack) end
end

local function giveShotgun()
    pcall(function()
        workspace.Remote.ItemHandler:InvokeServer(workspace.Prison_ITEMS.giver["Remington 870"].ITEMPICKUP)
    end)
end

local function shootHead(p,n)
    n=n or 10 if not p.Character then return end
    local head=p.Character:FindFirstChild("Head") if not head then return end
    giveShotgun() task.wait(0.15)
    local gun=getGun() if not gun then return end
    pcall(function() RS.ReloadEvent:FireServer(gun) end)
    local events={}
    for i=1,n do events[i]={Hit=head,Cframe=head.CFrame,RayObject=Ray.new(Vector3.new(),Vector3.new()),Distance=0} end
    pcall(function() RS.ShootEvent:FireServer(events,gun) end)
end
local function killPlr(p) if not p or p==lp then return end shootHead(p,10) end

local function bringPlr(p)
    if not p or p==lp or not p.Character then return end
    local r,t2=root(),p.Character:FindFirstChild("HumanoidRootPart")
    if not r or not t2 then return end
    pcall(function()
        local g=getgenv and getgenv() or {}
        if g.setsimulationradius then g.setsimulationradius(1e9) end
        if g.sethiddenproperty then g.sethiddenproperty(lp,"MaxSimulationRadius",1e9) end
        t2.CFrame=r.CFrame*CFrame.new(0,0,-4)
    end)
end

local function scr(v3)
    local v,on=cam:WorldToViewportPoint(v3)
    return Vector2.new(v.X,v.Y), on and v.Z>0
end
local function center()
    local s=cam.ViewportSize return Vector2.new(s.X/2,s.Y/2)
end
local function visCheck(part)
    if not cfg.saVis then return true end
    local pr=RaycastParams.new()
    pr.FilterDescendantsInstances={ch()} pr.FilterType=Enum.RaycastFilterType.Exclude
    local hit=workspace:Raycast(cam.CFrame.Position, part.Position-cam.CFrame.Position, pr)
    if not hit then return true end
    return hit.Instance and hit.Instance:IsDescendantOf(part.Parent)
end
local function aimPart(p)
    local c=p.Character if not c then return nil end
    if cfg.saHead and c:FindFirstChild("Head") then return c.Head end
    return c:FindFirstChild("HumanoidRootPart")
end
local function closestSA(maxPx)
    local c0=center() local best,bd=nil,maxPx
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=lp then
            local part=aimPart(p)
            local h2=p.Character and p.Character:FindFirstChildOfClass("Humanoid")
            if part and h2 and h2.Health>0 then
                local sp,on=scr(part.Position)
                if on then
                    local d=(sp-c0).Magnitude
                    if d<bd and visCheck(part) then bd=d best=p end
                end
            end
        end
    end
    return best,bd
end
local function aimedDirect()
    local unit=mouse.UnitRay
    local pr=RaycastParams.new()
    pr.FilterDescendantsInstances={ch()} pr.FilterType=Enum.RaycastFilterType.Exclude
    local hit=workspace:Raycast(unit.Origin,unit.Direction*400,pr)
    if not hit then return end
    local n=hit.Instance.Name
    if n~="Head" and n~="Torso" and n~="UpperTorso" and n~="HumanoidRootPart" then return end
    local pl=Players:GetPlayerFromCharacter(hit.Instance.Parent)
    if not pl or pl==lp then return end
    local h2=hit.Instance.Parent:FindFirstChildOfClass("Humanoid")
    if h2 and h2.Health>0 then return pl end
end
local function isLooseTool(t)
    if not t:IsA("Tool") or not t:FindFirstChild("Handle") then return false end
    for _,p in ipairs(Players:GetPlayers()) do
        if p.Character and t:IsDescendantOf(p.Character) then return false end
        if t.Parent and t.Parent==p:FindFirstChild("Backpack") then return false end
    end
    return t:IsDescendantOf(workspace)
end

-- ══════════════ SILENT AIM ══════════════
local function installSA()
    local wrap=newcclosure or function(f) return f end
    local chk=checkcaller or function() return false end
    if not hookmetamethod then return end
    local oldI
    oldI=hookmetamethod(game,"__index",wrap(function(self,k)
        if alive and cfg.on.silentAim and not chk() then
            if self==mouse and (k=="Hit" or k=="Target") then
                local plr=closestSA(cfg.saFov*4) local part=plr and aimPart(plr)
                if part then
                    if k=="Hit" then return part.CFrame end
                    if k=="Target" then return part end
                end
            end
        end
        return oldI(self,k)
    end))
    local oldN
    oldN=hookmetamethod(game,"__namecall",wrap(function(self,a1,a2,a3,a4,a5)
        if alive and cfg.on.silentAim and not chk() and getnamecallmethod()=="FireServer" then
            if self.Name=="ShootEvent" and type(a1)=="table" then
                local plr=closestSA(cfg.saFov*4) local part=plr and aimPart(plr)
                if part then
                    for _,ev in ipairs(a1) do
                        if type(ev)=="table" then ev.Hit=part ev.Cframe=part.CFrame end
                    end
                end
            end
        end
        return oldN(self,a1,a2,a3,a4,a5)
    end))
end
pcall(installSA)

