    for _, v in ipairs(workspace:GetDescendants()) do
        if isLooseTool(v) and v:FindFirstChild("Handle") then
            local d = (r.Position - v.Handle.Position).Magnitude
            if bd == nil or d < bd then
                best = v
                bd   = d
            end
        end
    end
    if best then
        pcall(function() best.Parent = lp.Backpack end)
        notify("Kyriel", "Grabbed: " .. best.Name)
    else
        giveShotgun()
        notify("Kyriel", "Gave shotgun from armory")
    end
end)
