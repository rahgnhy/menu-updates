local allGuiEl = {searchBar, side, tgt}

local function animMenuOpen()
    playSound(SND.open)
    for _, el in ipairs(allGuiEl) do
        el.Visible                = true
        el.BackgroundTransparency = 1
        TweenSvc:Create(el, TweenInfo.new(0.28, Enum.EasingStyle.Quart), {
            BackgroundTransparency = 0
        }):Play()
    end
end

local function animMenuClose()
    playSound(SND.close)
    for _, el in ipairs(allGuiEl) do
        TweenSvc:Create(el, TweenInfo.new(0.2, Enum.EasingStyle.Quart), {
            BackgroundTransparency = 1
        }):Play()
        task.delay(0.22, function()
            el.Visible                = false
            el.BackgroundTransparency = 0
        end)
    end
    for _, w in pairs(windows) do
        if w.Visible then
            TweenSvc:Create(w, TweenInfo.new(0.16, Enum.EasingStyle.Quart), {
                Size = UDim2.new(0, 228, 0, 0)
            }):Play()
            task.delay(0.18, function() w.Visible = false end)
        end
    end
    closeSett()
end

bind(UIS.InputBegan:Connect(function(i, g)
