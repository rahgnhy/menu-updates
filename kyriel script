    toggleTrigger.MouseButton1Click:Connect(toggleAction)

    local function toggleSettingsPanel()
        if not buildSettingsCallback or not settingsContainer then return end
        emitSound(SOUNDS.click)
        if activeSettingsPanel == settingsContainer then
            closeActiveSettings()
            dotLabel.TextColor3 = TEXT_MUTED
            return
        end
        closeActiveSettings()
        activeSettingsPanel = settingsContainer
        dotLabel.TextColor3 = ACCENT_COLOR
        settingsContainer.Visible = true
        settingsContainer.Size = UDim2.new(1, 0, 0, 0)
        local layout = settingsContainer:FindFirstChildOfClass("UIListLayout")
        local targetH = layout and layout.AbsoluteContentSize.Y or 60
        TweenService:Create(settingsContainer, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Size = UDim2.new(1, 0, 0, targetH)
        }):Play()
    end

    toggleTrigger.MouseButton2Click:Connect(toggleSettingsPanel)

    if buildSettingsCallback then
        local rightDotsBtn = Instance.new("TextButton")
        rightDotsBtn.Size                   = UDim2.new(0, 26, 1, 0)
        rightDotsBtn.Position               = UDim2.new(1, -26, 0, 0)
        rightDotsBtn.BackgroundTransparency = 1
        rightDotsBtn.Text                   = ""
        rightDotsBtn.ZIndex                 = 5
        rightDotsBtn.Parent                 = row
        rightDotsBtn.MouseButton1Click:Connect(toggleSettingsPanel)
    end

    attachHoverEffect(toggleTrigger, BG_TERTIARY, cfg.on[id] and TOGGLE_ON_BG or BG_SECONDARY)

    if cfg.on[id] then
        setFeatureEnabled(id, true)
    end
    return row
end

