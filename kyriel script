-- ══ MENU TOGGLE ANIMATION (RightShift) ══
local allUI={searchBar,side,tgt}

-- Cool open: elements fly in from different directions
local UIEntryData={
    [searchBar]={start=UDim2.new(0.5,-140,0,-30),  final=UDim2.new(0.5,-140,0,12)},
    [side]     ={start=UDim2.new(-0.2,0,0,54),     final=UDim2.new(0,16,0,54)},
    [tgt]      ={start=UDim2.new(-0.2,0,0,466),    final=UDim2.new(0,16,0,466)},
}

local function animMenuOpen()
    playSound(SND.open)
    for _,el in ipairs(allUI) do
        local data=UIEntryData[el]
        el.Visible=true
        if data then el.Position=data.start end
        el.BackgroundTransparency=1
        TweenSvc:Create(el,TweenInfo.new(0.35,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{
            BackgroundTransparency=0,
            Position=data and data.final or el.Position,
        }):Play()
    end
    -- Open windows that were previously open (saved state)
    for title,_ in pairs(windows) do
        if cfg.winOpen[title] then
            setWindowVisible(title,true,true)
        end
    end
end

local function animMenuClose()
    playSound(SND.close)
    -- Save which windows are open before closing
    for title,w in pairs(windows) do
        cfg.winOpen[title]=w.Visible
    end
    saveCfg()
    -- Close all windows with slide-out
    for _,w in pairs(windows) do
        if w.Visible then
            TweenSvc:Create(w,TweenInfo.new(0.18,Enum.EasingStyle.Quart,Enum.EasingDirection.In),{
                Size=UDim2.new(0,232,0,0),BackgroundTransparency=1
            }):Play()
            task.delay(0.2,function() w.Visible=false w.BackgroundTransparency=0 end)
        end
    end
    -- Slide UI out
    local outDirs={
        [searchBar]=UDim2.new(0.5,-140,0,-40),
        [side]     =UDim2.new(-0.2,0,0,54),
        [tgt]      =UDim2.new(-0.2,0,0,466),
    }
    for _,el in ipairs(allUI) do
        TweenSvc:Create(el,TweenInfo.new(0.28,Enum.EasingStyle.Quart,Enum.EasingDirection.In),{
            BackgroundTransparency=1,
            Position=outDirs[el] or el.Position,
        }):Play()
        task.delay(0.3,function()
            el.Visible=false el.BackgroundTransparency=0
            local data=UIEntryData[el]
            if data then el.Position=data.final end
        end)
    end
    closeSett()
end

bind(UIS.InputBegan:Connect(function(i,g)
    if g then return end
    if i.KeyCode==Enum.KeyCode.RightShift then
        menuOpen=not menuOpen
        if menuOpen then animMenuOpen() else animMenuClose() end
    end
end))

