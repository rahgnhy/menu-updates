    local bp=lp:FindFirstChild("Backpack")
    if bp then return scan(bp) end
    return nil
end

-- ══ SCREEN ══
local function scr(v3)
    local v,on=cam:WorldToViewportPoint(v3)
    return Vector2.new(v.X,v.Y), on and v.Z>0
end

local function aimPart(p)
    local c=p.Character if not c then return nil end
    if cfg.saHead then
        local h=c:FindFirstChild("Head") if h then return h end
    end
    return c:FindFirstChild("HumanoidRootPart")
end

local function visCheck(part)
    if not cfg.saVis then return true end
    local pr=RaycastParams.new()
    pr.FilterDescendantsInstances={ch()}
    pr.FilterType=Enum.RaycastFilterType.Exclude
    local hit=workspace:Raycast(cam.CFrame.Position, part.Position-cam.CFrame.Position, pr)
    if not hit then return true end
    return hit.Instance and hit.Instance:IsDescendantOf(part.Parent.Parent or part.Parent)
end

-- ══ CLOSEST TO CURSOR (VapeV4 method) ══
local function closestToCursor(fovPx)
    local mPos=Vector2.new(mouse.X, mouse.Y)
    local best,bestD=nil,fovPx
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=lp then
            local part=aimPart(p)
            local h2=p.Character and p.Character:FindFirstChildOfClass("Humanoid")
            if part and h2 and h2.Health>0 then
                local sp,on=scr(part.Position)
                if on then
                    local d=(sp-mPos).Magnitude
                    if d<bestD and visCheck(part) then bestD=d best=p end
                end
            end
        end
    end
    return best,bestD
end

-- ══ SILENT AIM (VapeV4 hookmetamethod) ══
local function installSA()
    if not hookmetamethod then return end
    local wrap = newcclosure or function(f) return f end
    local chk  = checkcaller or function() return false end

    local oldIdx
    oldIdx = hookmetamethod(game,"__index",wrap(function(self,k)
        if alive and cfg.on.silentAim and not chk() and self==mouse then
            local plr=closestToCursor(cfg.saFov)
            local part=plr and aimPart(plr)
            if part then
                if k=="Hit"    then return part.CFrame end
                if k=="Target" then return part end
                if k=="X"      then return select(1,scr(part.Position)).X end
                if k=="Y"      then return select(1,scr(part.Position)).Y end
            end
        end
        return oldIdx(self,k)
    end))

    local oldNC
    oldNC = hookmetamethod(game,"__namecall",wrap(function(self,...)
        local args={...}
        local method=getnamecallmethod()
        if alive and cfg.on.silentAim and not chk() and method=="FireServer" then
            local n = typeof(self)=="Instance" and self.Name or ""
            if n=="ShootEvent" or n=="shoot" or n=="Shoot" or n=="RemoteEvent" then
                local plr=closestToCursor(cfg.saFov)
                local part=plr and aimPart(plr)
                if part then
                    if type(args[1])=="table" then
                        for _,ev in ipairs(args[1]) do
                            if type(ev)=="table" then
                                ev.Hit=part ev.Cframe=part.CFrame
                                ev.Distance=(cam.CFrame.Position-part.Position).Magnitude
                            end
                        end
                    elseif typeof(args[1])=="Vector3" then args[1]=part.Position
                    elseif typeof(args[1])=="CFrame"  then args[1]=part.CFrame
                    end
                end
            end
        end
        return oldNC(self,table.unpack(args))
    end))
end
pcall(installSA)

-- ══ TRIGGERBOT ══
local function doTrigger()
    local c=ch() if not c then return end
    local tool=c:FindFirstChildWhichIsA("Tool") if not tool then return end
    local unit=mouse.UnitRay
    local pr=RaycastParams.new()
    pr.FilterDescendantsInstances={c}
    pr.FilterType=Enum.RaycastFilterType.Exclude
    local hit=workspace:Raycast(unit.Origin, unit.Direction*600, pr)
    if not hit then return end
    local model=hit.Instance:FindFirstAncestorOfClass("Model") if not model then return end
    local pl=Players:GetPlayerFromCharacter(model)
    if not pl or pl==lp then return end
    local h2=model:FindFirstChildOfClass("Humanoid")
    if not h2 or h2.Health<=0 then return end
    pcall(function() tool:Activate() end)
    -- Also fire remote for Prison Life guns
    local re=tool:FindFirstChildWhichIsA("RemoteEvent")
    if re then pcall(function() re:FireServer(hit.Position, unit.Direction) end) end
end

