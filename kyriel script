    for _, p in ipairs(Players:GetPlayers()) do
        local e   = esp[p]
        local tg  = tags[p]
        local c   = p.Character
        local r2  = c and c:FindFirstChild("HumanoidRootPart")
        local h2  = c and c:FindFirstChildOfClass("Humanoid")
        local col = getEspColor(p)

        if e then
            local show = cfg.on.esp and r2 ~= nil and h2 ~= nil and h2.Health > 0
            if show then
                local topV, on = scr(r2.Position + Vector3.new(0, 3.1, 0))
                local botV     = select(1, scr(r2.Position - Vector3.new(0, 3.0, 0)))
                if on then
                    local ht  = math.abs(topV.Y - botV.Y)
                    local w   = ht * 0.52
                    local cx  = topV.X
                    local cy  = topV.Y
                    local pct = h2.Health / h2.MaxHealth
                    local hCol= Color3.fromRGB(
                        math.floor((1 - pct) * 255),
                        math.floor(pct * 200),
                        50
                    )
                    local pulse = cfg.espPulse and (1 + math.sin(espPulseT) * 0.05) or 1
                    local pw    = w * pulse
                    local pht   = ht * pulse

                    if cfg.espStyle == "box" then
                        e.outline.Size     = Vector2.new(pw + 3, pht + 3)
                        e.outline.Position = Vector2.new(cx - (pw + 3) / 2, cy - 1)
                        e.outline.Color    = Color3.new(0, 0, 0)
                        e.outline.Visible  = true
                        e.box.Size         = Vector2.new(pw, pht)
                        e.box.Position     = Vector2.new(cx - pw / 2, cy)
                        e.box.Color        = col
                        e.box.Visible      = true
                        for _, l in ipairs(e.corners) do
                            l.Visible = false
                        end
                    else
                        e.box.Visible     = false
                        e.outline.Visible = false
                        local cl = pw * 0.28
                        local x1 = cx - pw / 2
                        local x2 = cx + pw / 2
                        local y1 = cy
                        local y2 = cy + pht
                        local function setL(l, fx, fy, tx, ty)
                            l.From    = Vector2.new(fx, fy)
                            l.To      = Vector2.new(tx, ty)
                            l.Color   = col
                            l.Visible = true
                        end
                        setL(e.corners[1], x1,      y1,      x1 + cl, y1)
                        setL(e.corners[2], x1,      y1,      x1,      y1 + cl)
                        setL(e.corners[3], x2,      y1,      x2 - cl, y1)
                        setL(e.corners[4], x2,      y1,      x2,      y1 + cl)
                        setL(e.corners[5], x1,      y2,      x1 + cl, y2)
                        setL(e.corners[6], x1,      y2,      x1,      y2 - cl)
                        setL(e.corners[7], x2,      y2,      x2 - cl, y2)
                        setL(e.corners[8], x2,      y2,      x2,      y2 - cl)
                    end

                    local bx   = cx - pw / 2 - 6
                    local barH = pht * pct
                    e.hBG.Size     = Vector2.new(4, pht)
                    e.hBG.Position = Vector2.new(bx, cy)
                    e.hBG.Visible  = true
                    e.hBar.Size    = Vector2.new(4, barH)
                    e.hBar.Position= Vector2.new(bx, cy + pht - barH)
                    e.hBar.Color   = hCol
                    e.hBar.Visible = true

                    e.snap.From    = botCenter
                    e.snap.To      = Vector2.new(cx, cy + pht)
                    e.snap.Color   = col
                    e.snap.Visible = false
                else
                    for _, l in ipairs(e.corners) do l.Visible = false end
                    e.box.Visible     = false
                    e.outline.Visible = false
                    e.hBG.Visible     = false
                    e.hBar.Visible    = false
                    e.snap.Visible    = false
                end
            else
                for _, l in ipairs(e.corners) do l.Visible = false end
                e.box.Visible     = false
                e.outline.Visible = false
                e.hBG.Visible     = false
                e.hBar.Visible    = false
                e.snap.Visible    = false
            end
        end

        if tg then
            if cfg.on.nameTags and r2 and h2 and h2.Health > 0 then
                local sp, on2 = scr(r2.Position + Vector3.new(0, 3.9, 0))
                if on2 then
                    if cfg.tagStyle == "minimal" then
                        tg.Text = p.Name
                    elseif cfg.tagStyle == "full" then
                        local dist = math.floor((cam.CFrame.Position - r2.Position).Magnitude)
                        tg.Text = string.format("%s [%d❤] [%dm]", p.Name, math.floor(h2.Health), dist)
                    else
                        tg.Text = string.format("%s [%d]", p.Name, math.floor(h2.Health))
                    end
                    tg.Position = sp
                    tg.Color    = getEspColor(p)
                    tg.Visible  = true
                else
                    tg.Visible = false
                end
            else
                tg.Visible = false
            end
        end
    end
end))

