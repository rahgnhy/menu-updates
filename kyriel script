local function screenPosition(worldPos)
    local screenPos, onScreen = Camera:WorldToViewportPoint(worldPos)
    return Vector2.new(screenPos.X, screenPos.Y), onScreen and screenPos.Z > 0
end

local function getPlayerTeam(player)
    if not player then return "default" end
    local team = player.Team
    if not team then return "default" end
    local tc = team.TeamColor
    if tc == BrickColor.new("Bright blue")   then return "police" end
    if tc == BrickColor.new("Bright orange") then return "prisoner" end
    if tc == BrickColor.new("Really red")    then return "criminal" end
    local name = team.Name:lower()
    if name:find("guard") or name:find("police") then return "police" end
    if name:find("criminal")                     then return "criminal" end
    if name:find("inmate") or name:find("prisoner") then return "prisoner" end
    return "default"
end

local function isPlayerArrestable(player)
    if not player or player == LocalPlayer or not player.Character then return false end
    local teamName = getPlayerTeam(player)
    return teamName == "criminal" or teamName == "prisoner"
end

local function isLocalGuard()
