        playSound(newState and SND.on or SND.off)
        doAnim(item, newState and A or Color3.fromRGB(180, 60, 60))
        setOn(id, newState)
    end)
    addHover(leftBtn, ROW2, cfg.on[id] and ON or ROW)

    if buildSettings and settPanel then
        local rightBtn = Instance.new("TextButton")
        rightBtn.Size             = UDim2.new(0, 28, 1, 0)
        rightBtn.Position         = UDim2.new(1, -28, 0, 0)
        rightBtn.BackgroundTransparency = 1
        rightBtn.Text             = ""
        rightBtn.ZIndex           = 5
        rightBtn.AutoButtonColor  = false
        rightBtn.Parent           = item

        rightBtn.MouseButton1Click:Connect(function()
            playSound(SND.click)
            if openSett == settPanel then
                closeSett()
                settDot.TextColor3 = MUTED
                return
            end
            closeSett()
            openSett           = settPanel
            settDot.TextColor3 = A
            settPanel.Visible  = true
            settPanel.Size     = UDim2.new(1, 0, 0, 0)
            local sl           = settPanel:FindFirstChildOfClass("UIListLayout")
            local targetH      = sl and sl.AbsoluteContentSize.Y or 60
            TweenSvc:Create(settPanel, TweenInfo.new(0.22, Enum.EasingStyle.Quart), {
                Size = UDim2.new(1, 0, 0, targetH)
            }):Play()
        end)
        addHover(rightBtn, ROW2, cfg.on[id] and ON or ROW)
    end

    if cfg.on[id] then setOn(id, true) end
    return item
end

